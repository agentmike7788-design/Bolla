[gd_resource type="Resource" script_class="VillagerData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/village/villager_data.gd" id="1"]

[resource]
script = ExtResource("1")
npc_id = &"grocer"
display_name = "Theres Mangold"
role = "Krämerin"
dialogue_id = &"v_grocer"
shop_id = &"grocer"
home_door = &""
gifts_liked = Array[StringName]([&"herbs", &"elderberries"])
start_value = 20
specimen_delta = 0
returned_delta = 0
piety_sensitive = false
remarks = Dictionary[StringName, PackedStringArray]({
&"friend": PackedStringArray("Ich hab dir was Buntes zurückgelegt. Frag nicht, nimm es mit.", "Ich hab etwas Buntes für Sie! Ich weiß nicht, was es ist. Darum ist es bunt."),
&"rep_disreputable": PackedStringArray("Zwei, drei, vier … der Totengräber zahlt heute bar, ja?", "Drei, vier, fünf – und der Totengräber, sechs. Ich zähle alles, was vorbeigeht."),
&"rep_esteemed": PackedStringArray("Meine Mutter hätte dich gemocht. Sie mochte ordentliche Leute.", "Für Sie lege ich das gute Leinen zurück. Rechnen Sie nicht nach, ich hab es schon."),
&"rep_renowned": PackedStringArray("Für den Totengräber leg ich die gute Ware nach vorn.", "Der Herr Totengräber! Meine Mutter hätte Ihnen einen Stuhl hingestellt. Ich stelle Ihnen zwei hin."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott.", "Drei Ellen Leinen, ich weiß schon. Ich rechne es dir zusammen.", "Grüß Gott, Herr Totengräber! Ich hab Wachs, ich hab Kerzen, ich hab Buntes."),
&"rep_unremarkable": PackedStringArray("Leinen, Kerzen, Buntes. Was soll's sein?", "Leinen ist frisch, Herr Totengräber! Sechs Ellen, und dann ist es weg."),
&"specimens": PackedStringArray("Gläser, Gläser. Seit Sie im Dorf sind, verkaufe ich mehr Gläser als Gurken. Das rechne ich mir nicht aus.")
})
