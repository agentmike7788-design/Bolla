remarks = Dictionary[StringName, PackedStringArray]({
&"rep_disreputable": PackedStringArray("Da ist er ja, der Schlimme! Komm her, ich hab keine Taschen mehr."),
&"rep_unremarkable": PackedStringArray("Schönes Wetter zum Sterben, Totengräber! Mach ich aber noch nicht."),
&"rep_respected": PackedStringArray("Mein Totengräber! Halt mir oben ein Plätzchen warm."),
&"rep_esteemed": PackedStringArray("Na, Junge? Wie geht's den Toten? Besser als mir, wette ich."),
&"rep_renowned": PackedStringArray("Da kommt mein Totengräber! Wenn ich das gewusst hätte, wär ich früher alt geworden."),
&"friend": PackedStringArray("Ich hab dir Mohnsamen aufgehoben. Für oben. Für mich. Du weißt schon."),
&"specimens": PackedStringArray("Wehe, du nimmst mir was weg, wenn ich oben bin. Ich hab's Liesel gesagt, und Liesel vergisst nichts.")
})
