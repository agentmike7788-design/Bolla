[gd_resource type="Resource" script_class="VillagerData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/village/villager_data.gd" id="1"]

[resource]
script = ExtResource("1")
npc_id = &"oldwoman"
display_name = "Wiebke Hagedorn"
role = "Altenteilerin"
dialogue_id = &"v_oldwoman"
shop_id = &""
home_door = &""
gifts_liked = Array[StringName]([&"seeds", &"honey_cake"])
start_value = 30
specimen_delta = -2
returned_delta = 0
piety_sensitive = false
remarks = Dictionary[StringName, PackedStringArray]({
&"friend": PackedStringArray("Setz dich, Junge. Ich erzähl dir, wie's früher am Brunnen war.", "Ich hab dir Mohnsamen aufgehoben. Für oben. Für mich. Du weißt schon."),
&"rep_disreputable": PackedStringArray("Du bist also der. Ich hab mir dich größer vorgestellt. Und gewaschener.", "Da ist er ja, der Schlimme! Komm her, ich hab keine Taschen mehr."),
&"rep_esteemed": PackedStringArray("Man sagt, bei dir liegt man trocken. Das ist mir wichtig, ich hab's an den Knien.", "Na, Junge? Wie geht's den Toten? Besser als mir, wette ich."),
&"rep_renowned": PackedStringArray("Wenn's so weit ist, will ich zu dir. Hab ich dem Pfarrer schon gesagt.", "Da kommt mein Totengräber! Wenn ich das gewusst hätte, wär ich früher alt geworden."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott.", "Mit Blick auf die Linde, merk dir das. Nicht vergessen.", "Mein Totengräber! Halt mir oben ein Plätzchen warm."),
&"rep_unremarkable": PackedStringArray("Na, Totengräber? Noch hab ich keine Zeit für dich.", "Schönes Wetter zum Sterben, Totengräber! Mach ich aber noch nicht."),
&"specimens": PackedStringArray("Die Leute sagen, beim Quast klirrt es. Lass mich ganz, hörst du?", "Wehe, du nimmst mir was weg, wenn ich oben bin. Ich hab's Liesel gesagt, und Liesel vergisst nichts.")
})
