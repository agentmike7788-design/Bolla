remarks = Dictionary[StringName, PackedStringArray]({
&"friend": PackedStringArray("Kommen Sie herein. Ich habe Tee. Nur Tee, keine Sorge."),
&"piety_devout": PackedStringArray("Sie gehen mit ihnen um, als schliefen sie nur. Verzeihen Sie, das ist kein Vorwurf."),
&"piety_hardhearted": PackedStringArray("Sie sehen inzwischen hin, ohne zu zögern. Das ist nützlich. Und traurig."),
&"rep_disreputable": PackedStringArray("Man spricht nicht gut von Ihnen. Von mir übrigens auch nicht."),
&"rep_esteemed": PackedStringArray("Ihre Toten sind sauber versorgt. Das ist mehr, als man von den meisten Ärzten sagen kann."),
&"rep_renowned": PackedStringArray("Man kennt Ihren Namen bis in die Stadt. Seien Sie vorsichtig damit."),
&"rep_respected": PackedStringArray("Die Toten lehren die Lebenden."),
&"rep_unremarkable": PackedStringArray("Guten Tag. Viel zu tun, oben?")
})
