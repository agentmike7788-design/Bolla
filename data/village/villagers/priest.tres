remarks = Dictionary[StringName, PackedStringArray]({
&"piety_devout": PackedStringArray("Du hast ruhige Hände bekommen. Das sieht man an den Gräbern."),
&"piety_hardhearted": PackedStringArray("Du gehst schwer, mein Sohn. Schwerer als die, die du trägst."),
&"rep_disreputable": PackedStringArray("Man hört Dinge über den Hügel, mein Sohn. Ich höre sie ungern."),
&"rep_esteemed": PackedStringArray("Die Leute sagen, auf dem Hügel liegt man gut. Das freut mich."),
&"rep_renowned": PackedStringArray("Wenn ich einmal gehe, dann zu dir hinauf. Das sage ich jetzt schon."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott."),
&"rep_unremarkable": PackedStringArray("Gott zum Gruße. Wir sehen uns zu selten."),
&"specimens": PackedStringArray("Quast hat wieder Post vom Hügel, sagt man.")
})
