[gd_resource type="Resource" script_class="VillagerData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/village/villager_data.gd" id="1"]

[resource]
script = ExtResource("1")
npc_id = &"priest"
display_name = "Ambrosius Lenz"
role = "Pfarrer von St. Gallus"
dialogue_id = &"v_priest"
shop_id = &"priest"
home_door = &""
gifts_liked = Array[StringName]([&"elder_wine", &"honey_cake"])
start_value = 25
specimen_delta = -4
returned_delta = 1
piety_sensitive = true
remarks = Dictionary[StringName, PackedStringArray]({
&"piety_devout": PackedStringArray("Du hast ruhige Hände bekommen. Das sieht man an den Gräbern.", "Sie gehen leise, Totengräber. Wie einer, der nichts wecken will."),
&"piety_hardhearted": PackedStringArray("Du gehst schwer, mein Sohn. Schwerer als die, die du trägst.", "Totengräber. Ich bete. Sie müssen nichts sagen. Ich bete einfach."),
&"rep_disreputable": PackedStringArray("Man hört Dinge über den Hügel, mein Sohn. Ich höre sie ungern.", "Grüß Gott, Totengräber. Ich bete für alle. Auch für Sie. Vor allem."),
&"rep_esteemed": PackedStringArray("Die Leute sagen, auf dem Hügel liegt man gut. Das freut mich.", "Ah, der Totengräber! Die Gemeinde spricht gut von Ihnen. Ich auch, aber länger."),
&"rep_renowned": PackedStringArray("Wenn ich einmal gehe, dann zu dir hinauf. Das sage ich jetzt schon.", "Mein lieber Totengräber! Wenn Sie wüssten, wie oft Ihr Name in meinen Gebeten vorkommt."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott.", "Grüß Gott, Totengräber! Ich habe am Sonntag von Ihnen gesprochen. Nicht namentlich."),
&"rep_unremarkable": PackedStringArray("Gott zum Gruße. Wir sehen uns zu selten.", "Grüß Gott! Ein schöner Tag. Oder ein gewöhnlicher. Beides ist ein Geschenk."),
&"specimens": PackedStringArray("Quast hat wieder Post vom Hügel, sagt man.", "Quast hat wieder Post vom Hügel, sagt man. Ich sage nichts. Ich bete nur länger."),
&"friend": PackedStringArray("Kommen Sie doch einmal am Abend in den Holderkrug. Ich lade Sie ein. Rosine wird es mir nicht glauben.")
})
