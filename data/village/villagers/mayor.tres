[gd_resource type="Resource" script_class="VillagerData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/village/villager_data.gd" id="1"]

[resource]
script = ExtResource("1")
npc_id = &"mayor"
display_name = "Gottlieb Fenner"
role = "Schultheiß"
dialogue_id = &"v_mayor"
shop_id = &""
home_door = &"door_office"
gifts_liked = Array[StringName]([&"ink", &"honey_cake"])
start_value = 30
specimen_delta = 0
returned_delta = 0
piety_sensitive = false
remarks = Dictionary[StringName, PackedStringArray]({
&"friend": PackedStringArray("Setzen Sie sich, Totengräber. Die Akten können warten.", "Unter uns: Die Beine sind besser. Amtlich weiß ich davon nichts."),
&"rep_disreputable": PackedStringArray("Der Gemeinderat hat Beschwerden vorliegen, Totengräber. Schriftliche.", "Totengräber. Es liegen Beschwerden vor. Schriftlich. Guten Tag."),
&"rep_esteemed": PackedStringArray("Der Gemeinderat ist zufrieden. Das kommt selten vor, glauben Sie mir.", "Ich habe Sie lobend ins Protokoll geschrieben. Zweimal. Das ist ein Rekord."),
&"rep_renowned": PackedStringArray("Wenn das Pflegegeld nicht reicht, sagen Sie es mir. Unter uns.", "Mein verehrter Totengräber! Ich arbeite an einer Satzung für Ihre Ehrung."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott.", "Ihre Pflege ist ordnungsgemäß. Ich habe es vermerkt.", "Totengräber! Die Gemeinde ist zufrieden. Das darf ich amtlich sagen."),
&"rep_unremarkable": PackedStringArray("Ah, der Totengräber. Die Gemeinde hat Sie zur Kenntnis genommen.", "Guten Tag. Die Amtsstube hat bis sechzehn Uhr geöffnet."),
&"specimens": PackedStringArray("Man redet über Gläser vom Hügel. Ich habe es nicht zu Protokoll genommen. Noch nicht.")
})
