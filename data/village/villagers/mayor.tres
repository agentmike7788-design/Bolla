&"friend": PackedStringArray("Setzen Sie sich, Totengräber. Die Akten können warten."),
&"rep_disreputable": PackedStringArray("Der Gemeinderat hat Beschwerden vorliegen, Totengräber. Schriftliche."),
&"rep_esteemed": PackedStringArray("Der Gemeinderat ist zufrieden. Das kommt selten vor, glauben Sie mir."),
&"rep_renowned": PackedStringArray("Wenn das Pflegegeld nicht reicht, sagen Sie es mir. Unter uns."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott.", "Ihre Pflege ist ordnungsgemäß. Ich habe es vermerkt."),
