[gd_resource type="Resource" script_class="VillagerData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/village/villager_data.gd" id="1"]

[resource]
script = ExtResource("1")
npc_id = &"washer"
display_name = "Liesel Dorn"
role = "Seelfrau und Spinnerin"
dialogue_id = &"v_washer"
shop_id = &"washer"
home_door = &""
gifts_liked = Array[StringName]([&"linen", &"honey_cake"])
start_value = 10
specimen_delta = -3
returned_delta = 2
piety_sensitive = true
remarks = Dictionary[StringName, PackedStringArray]({
&"event_apprentice_hired": PackedStringArray("Jakob auf dem Friedhof. Pass auf, dass er nicht zu früh lernt, wie still es da ist."),
&"event_grave_disturbed": PackedStringArray("Ein offenes Grab. Ich hab heute zweimal nachgesehen, ob meine noch zu sind."),
&"event_kathrein_danced": PackedStringArray("Du tanzt, wie man Särge trägt. Vorsichtig. Das ist nicht schlecht."),
&"event_lights_all": PackedStringArray("Jedes Grab hatte sein Licht. Auch die, nach denen keiner mehr fragt."),
&"event_noise_at_grave": PackedStringArray("Am Grab arbeitet man leise, wenn einer da ist. Das weißt du doch."),
&"event_robber_let_go": PackedStringArray("Du hast ihn laufen lassen. Das hätte Lorenz auch getan."),
&"event_robber_reported": PackedStringArray("Sie haben ihn mitgenommen. Er hat sich nicht gewehrt, sagt man."),
&"event_wish_done": PackedStringArray("Sie sagen, du hast gehalten, was du versprochen hast. Bei den Toten zählt das mehr."),
&"friend": PackedStringArray("Komm her, setz dich. Ich hab dir einen Faden gesponnen. Für nichts. Einfach so."),
&"piety_devout": PackedStringArray("Du riechst nach Wacholder. Das ist ein guter Geruch für einen wie dich."),
&"piety_hardhearted": PackedStringArray("Du riechst nach Branntwein und kaltem Stein. Bleib weg von meinem Garn."),
&"rep_disreputable": PackedStringArray("Der da. Der nimmt den Toten was weg, sagen sie. Ich sag nichts. Ich spinne."),
&"rep_esteemed": PackedStringArray("Die alte Kehr sagt, du hast ihren Mann gut hingelegt. Gutes Weinen war das."),
&"rep_renowned": PackedStringArray("Totengräber. Bei dir kommen sie an, als hätten sie es gut gehabt."),
&"rep_respected": PackedStringArray("Der Totengräber. Grüß Gott."),
&"rep_unremarkable": PackedStringArray("Hm. Der Totengräber."),
&"specimens": PackedStringArray("Wieder ein Glas mit einem Namen drauf, hört man. Ich hab sie gewaschen, Totengräber. Alle.")
})
circle = Array[StringName]([&"cottage_dorn", &"cottage_hagedorn"])
mood_lines = Dictionary[StringName, PackedStringArray]({
&"cheerful": PackedStringArray("Heute ist der Faden gut. Das kommt selten.", "Du kommst wie gerufen. Das tut fast keiner."),
&"cross": PackedStringArray("Heute nicht, Totengräber. Morgen.", "Was du mit den Toten machst, geht mich was an."),
&"low": PackedStringArray("Heute wasch ich nur. Reden kann ich morgen.", "Es hängt wieder ein Tuch im Fenster. Ich weiß, was das heißt."),
&"plain": PackedStringArray("Totengräber. Die Spindel dreht sich.", "Setz dich. Oder geh. Beides recht.")
})
story_id = &"washer"
favor_id = &"fav_washer"
visit_grave = ""
visit_every_days = 4
graveyard_npc = &"npc_washer_g"
