[sub_resource type="Resource" id="p8_menu_menu_05"]
script = ExtResource("2")
text = "[Geschichte] Das Wort am Lichtgang"
next = &"story_3"
conditions = Array[String](["step_offerable:priest", "step_gte:priest:2", "!step_gte:priest:3"])

[sub_resource type="Resource" id="p8_menu_menu_06"]
script = ExtResource("2")
text = "Über die Namen am Lichtgang"
next = &"story_3_done"
conditions = Array[String](["flag:friend_priest_3", "!flag:p8_told_priest_3"])
actions = Array[String](["set_flag:p8_told_priest_3"])

[sub_resource type="Resource" id="p8_menu_menu_07"]
