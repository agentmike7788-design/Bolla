conditions = Array[String](["p8_open", "mood:priest:cross", "!step_gte:priest:3"])

[sub_resource type="Resource" id="p8_menu_menu_08"]
script = ExtResource("2")
text = "[Zuhören]"
next = &"listen"
conditions = Array[String](["p8_open", "mood:priest:low", "!flag_today:p8_listen_priest"])
