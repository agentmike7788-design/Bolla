[sub_resource type="Resource" id="p8_p8_hill_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_hill"]
script = ExtResource("1")
id = &"p8_hill"
text = "Ich bin bei meinen. Die Hagedorn und die anderen. Ich hab ihnen einen Faden gebracht. Frag nicht, wofür."
choices = Array[ExtResource("2")]([SubResource("p8_p8_hill_c01")])
conditions = Array[String](["p8_open", "region:graveyard"])
fallback_next = &"start"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="p8_story_2_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_2_yes"
actions = Array[String](["step_accept:washer"])

[sub_resource type="Resource" id="p8_story_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2"]
script = ExtResource("1")
id = &"story_2"
text = "Halt einmal mit mir Totenwache. Wenn einer unten liegt, in deiner Gruft, komm ich um halb zehn die Treppe hinunter. Eine Stunde. Du musst nichts sagen. Du musst nur dableiben."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_c01"), SubResource("p8_story_2_c02")])

[sub_resource type="Resource" id="p8_story_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_yes"]
script = ExtResource("1")
id = &"story_2_yes"
text = "Halb zehn. Lass die Lampe an."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_yes_c01")])

[sub_resource type="Resource" id="p8_story_2_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_done"]
script = ExtResource("1")
id = &"story_2_done"
text = "Du bist geblieben. Die meisten gehen nach einer Viertelstunde, weil sie es nicht aushalten, wie still es ist. Es ist nicht still. Man muss nur lange genug sitzen."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_done_c01")])

[sub_resource type="Resource" id="p8_story_3_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_3_yes"
actions = Array[String](["step_accept:washer"])

[sub_resource type="Resource" id="p8_story_3_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3"]
script = ExtResource("1")
id = &"story_3"
text = "Komm einmal zu mir, an meine Tür, am Nachmittag. Ich will dir was zeigen. Nicht hier, wo alle stehen."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_c01"), SubResource("p8_story_3_c02")])

[sub_resource type="Resource" id="p8_story_3_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_yes"]
script = ExtResource("1")
id = &"story_3_yes"
text = "Nachmittags. Klopf nicht, ich hör dich."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_yes_c01")])

[sub_resource type="Resource" id="p8_story_3_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_done"]
script = ExtResource("1")
id = &"story_3_done"
text = "Du hast es versprochen. Ich hab's gehört. Das Buch auch."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_done_c01")])

[sub_resource type="Resource" id="p8_story_cross_c01"]
script = ExtResource("2")
text = "Morgen also."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_cross"]
script = ExtResource("1")
id = &"story_cross"
text = "Heute nicht, Totengräber. Morgen."
choices = Array[ExtResource("2")]([SubResource("p8_story_cross_c01")])

[sub_resource type="Resource" id="p8_listen_c01"]
script = ExtResource("2")
text = "(Schweigen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_listen"]
script = ExtResource("1")
id = &"listen"
text = "Heute hab ich eine gewaschen, die hat mich gekannt, als ich klein war. Sie hat mir Äpfel gegeben, wenn Kaspar mir meine weggenommen hat. Ich hab ihr die Haare gekämmt, wie sie es mochte. … Geh jetzt. Nein, bleib noch."
choices = Array[ExtResource("2")]([SubResource("p8_listen_c01")])

[sub_resource type="Resource" id="p8_favor_c01"]
script = ExtResource("2")
text = "Danke, Liesel."
next = &"favor_done"
actions = Array[String](["favor_use:washer"])

[sub_resource type="Resource" id="p8_favor_c02"]
script = ExtResource("2")
text = "Ein andermal."
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor"]
script = ExtResource("1")
id = &"favor"
text = "Ich wasch dir einen. Morgen, halb zehn, in deiner Gruft. Ich komm runter. Leg Leinen und Hemd hin."
choices = Array[ExtResource("2")]([SubResource("p8_favor_c01"), SubResource("p8_favor_c02")])

[sub_resource type="Resource" id="p8_favor_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor_done"]
script = ExtResource("1")
id = &"favor_done"
text = "Morgen, wenn einer unten liegt. Halb zehn. Leg Leinen und Hemd bereit, ich bring nur meine Hände mit."
choices = Array[ExtResource("2")]([SubResource("p8_favor_done_c01")])

[sub_resource type="Resource" id="p8_o_of_liesel_return_1_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_liesel_return_1_yes"
actions = Array[String](["order_accept:of_liesel_return_1"])

[sub_resource type="Resource" id="p8_o_of_liesel_return_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_liesel_return_1"]
script = ExtResource("1")
id = &"o_of_liesel_return_1"
text = "Zwei Bahnen Leinen. Für die Nächsten."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_liesel_return_1_c01"), SubResource("p8_o_of_liesel_return_1_c02")])

[sub_resource type="Resource" id="p8_o_of_liesel_return_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_liesel_return_1_yes"]
script = ExtResource("1")
id = &"o_of_liesel_return_1_yes"
text = "Gut."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_liesel_return_1_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_liesel_return_1_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_liesel_return_1"]
script = ExtResource("1")
id = &"t_of_liesel_return_1"
text = "Gutes Leinen. Das hält."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_liesel_return_1_c01")])

[sub_resource type="Resource" id="p8_o_of_liesel_return_2_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_liesel_return_2_yes"
actions = Array[String](["order_accept:of_liesel_return_2"])

[sub_resource type="Resource" id="p8_o_of_liesel_return_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_liesel_return_2"]
script = ExtResource("1")
id = &"o_of_liesel_return_2"
text = "Vier Strang Garn."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_liesel_return_2_c01"), SubResource("p8_o_of_liesel_return_2_c02")])

[sub_resource type="Resource" id="p8_o_of_liesel_return_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_liesel_return_2_yes"]
script = ExtResource("1")
id = &"o_of_liesel_return_2_yes"
text = "Gut."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_liesel_return_2_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_liesel_return_2_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_liesel_return_2"]
script = ExtResource("1")
id = &"t_of_liesel_return_2"
text = "Vier. Danke."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_liesel_return_2_c01")])

[sub_resource type="Resource" id="p8_dance_c01"]
script = ExtResource("2")
text = "(Zurück an den Tisch)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_dance"]
script = ExtResource("1")
id = &"dance"
text = "Von acht bis neun, Totengräber, nicht länger. Ich tanz nicht gut. Ich tanz nur lang."
choices = Array[ExtResource("2")]([SubResource("p8_dance_c01")])

[sub_resource type="Resource" id="p8_story_1_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_1_yes"
actions = Array[String](["step_accept:washer"])

[sub_resource type="Resource" id="p8_story_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1"]
script = ExtResource("1")
id = &"story_1"
text = "Er heißt nicht Lorenz. Er heißt Kaspar. Kaspar Dorn. Setz seinen Namen auf den Stein, Totengräber. Mit Tinte, ordentlich. Dann weiß wenigstens der Stein, wer er war."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_c01"), SubResource("p8_story_1_c02")])
conditions = Array[String](["flag:insight_not_lorenz"])
fallback_next = &"story_1_alt"

[sub_resource type="Resource" id="p8_story_1_alt_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_1_yes"
actions = Array[String](["step_accept:washer"])

[sub_resource type="Resource" id="p8_story_1_alt_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_alt"]
script = ExtResource("1")
id = &"story_1_alt"
text = "Die Hagedorn. Halt ihr das Grab sauber, drei Morgen, und stell ihr eine Nacht ein Licht hin. Sie hat im Dunkeln nie schlafen können. Sie hat es keinem gesagt. Mir schon."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_alt_c01"), SubResource("p8_story_1_alt_c02")])

[sub_resource type="Resource" id="p8_story_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_yes"]
script = ExtResource("1")
id = &"story_1_yes"
text = "Gut. Ich seh nach. Nicht weil ich dir nicht trau. Weil ich nachseh."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_yes_c01")])

[sub_resource type="Resource" id="p8_story_1_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_done"]
script = ExtResource("1")
id = &"story_1_done"
text = "Ich war oben. Hab's gesehen. Ich hab nichts gesagt, und du warst nicht da. Das war gut so."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_done_c01")])

[sub_resource type="Resource" id="p8_story_2_vigil_c01"]
script = ExtResource("2")
text = "(Bleiben)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_vigil"]
script = ExtResource("1")
id = &"story_2_vigil"
text = "Setz dich. Da, auf die Stufe. … Die mit dem Zeichen wasch ich anders. Langsamer. Ich fang beim Herzen an und hör beim Herzen auf. Lorenz hat gesagt, das ist Aberglaube. Ich hab gesagt: Dann wasch du sie."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_vigil_c01")])

[sub_resource type="Resource" id="p8_story_3_meet_c01"]
script = ExtResource("2")
text = "Ich verspreche es."
next = &"story_3_promise"
actions = Array[String](["set_flag:promise_liesel_book"])

[sub_resource type="Resource" id="p8_node_story_3_meet"]
script = ExtResource("1")
id = &"story_3_meet"
text = "Hier stehen sie alle. Die mit dem Zeichen. Ich hab sie gewaschen und hineingeschrieben, damit sie nicht nur bei mir sind. Wenn ich sterbe, kommt das Buch mit mir hinunter. Versprich es."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_meet_c01")])

[sub_resource type="Resource" id="p8_story_3_promise_c01"]
script = ExtResource("2")
text = "(Gehen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_promise"]
script = ExtResource("1")
id = &"story_3_promise"
text = "Sie schlägt die letzte Seite auf und wieder zu, bevor du lesen kannst. Dann legt sie das Buch zurück unter das Kissen. „Gut. Jetzt geh. Und sag es keinem. Auch Lenz nicht.“"
choices = Array[ExtResource("2")]([SubResource("p8_story_3_promise_c01")])
conditions = Array[String](["insight:i_underlined"])
fallback_next = &"story_3_promise_plain"

[sub_resource type="Resource" id="p8_story_3_promise_plain_c01"]
script = ExtResource("2")
text = "(Gehen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_promise_plain"]
script = ExtResource("1")
id = &"story_3_promise_plain"
text = "Gut. Jetzt geh. Und sag es keinem. Auch Lenz nicht."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_promise_plain_c01")])

[sub_resource type="Resource" id="v_washer_c001"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_start"]
script = ExtResource("1")
id = &"start"
text = "Hm. Du bist der, der sie oben eingräbt. Ich bin die, die sie vorher wäscht. Dorn, Liesel. Kaspar war mein Bruder. Mehr musst du nicht wissen. Zieh das Bein ein, du stehst auf meinem Garn."
choices = Array[ExtResource("2")]([SubResource("v_washer_c001")])
conditions = Array[String](["!met:washer"])
fallback_next = &"hagedorn_gate"
actions = Array[String](["meet:washer", "talked:washer"])

[sub_resource type="Resource" id="v_washer_c002"]
script = ExtResource("2")
text = "Ich weiß."
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_hagedorn_gate"]
script = ExtResource("1")
id = &"hagedorn_gate"
text = "Sie ist tot, Totengräber. Die Hagedorn. Heute Nacht, im Schlaf. Ich hab sie gewaschen. Sie hat gesagt, du weißt, was sie will. Linde, Mohn, Totenhemd. Und nichts wegnehmen. Hörst du? Nichts."
choices = Array[ExtResource("2")]([SubResource("v_washer_c002")])
conditions = Array[String](["!alive:oldwoman", "!flag:liesel_hagedorn_told"])
fallback_next = &"greet_p_devout"
actions = Array[String](["set_flag:liesel_hagedorn_told", "talked:washer"])

[sub_resource type="Resource" id="v_washer_c003"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_p_devout"]
script = ExtResource("1")
id = &"greet_p_devout"
text = "Du riechst nach Wacholder. Das ist ein guter Geruch für einen wie dich. Komm her."
choices = Array[ExtResource("2")]([SubResource("v_washer_c003")])
conditions = Array[String](["piety_tier:devout"])
fallback_next = &"greet_p_hardhearted"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c004"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_p_hardhearted"]
script = ExtResource("1")
id = &"greet_p_hardhearted"
text = "Du riechst nach Branntwein und kaltem Stein. Ich weiß, was das heißt. Bleib da stehen."
choices = Array[ExtResource("2")]([SubResource("v_washer_c004")])
conditions = Array[String](["piety_tier:hardhearted"])
fallback_next = &"greet_disreputable"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c005"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_disreputable"]
script = ExtResource("1")
id = &"greet_disreputable"
text = "Du. Bleib da stehen. Näher brauchst du nicht."
choices = Array[ExtResource("2")]([SubResource("v_washer_c005")])
conditions = Array[String](["rep_tier:disreputable"])
fallback_next = &"greet_unremarkable"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c006"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_unremarkable"]
script = ExtResource("1")
id = &"greet_unremarkable"
text = "Na. Was willst du?"
choices = Array[ExtResource("2")]([SubResource("v_washer_c006")])
conditions = Array[String](["rep_tier:unremarkable"])
fallback_next = &"greet_respected"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c007"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_respected"]
script = ExtResource("1")
id = &"greet_respected"
text = "Ah, der Totengräber. Die alte Kehr hat gesagt, du hast ihren Mann ordentlich hingelegt. Sie hat geweint. Gutes Weinen."
choices = Array[ExtResource("2")]([SubResource("v_washer_c007")])
conditions = Array[String](["rep_tier:respected"])
fallback_next = &"greet_esteemed"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c008"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_esteemed"]
script = ExtResource("1")
id = &"greet_esteemed"
text = "Setz dich. Da, auf den Hackklotz. Ich spinne weiter, du redest, und wenn du was Dummes sagst, hör ich's am Faden."
choices = Array[ExtResource("2")]([SubResource("v_washer_c008")])
conditions = Array[String](["rep_tier:esteemed"])
fallback_next = &"greet_renowned"
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c009"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_greet_renowned"]
script = ExtResource("1")
id = &"greet_renowned"
text = "Totengräber. Die Toten kommen bei dir an, als hätten sie es gut gehabt. Das hab ich lange nicht gesehen. Setz dich."
choices = Array[ExtResource("2")]([SubResource("v_washer_c009")])
actions = Array[String](["talked:washer"])

[sub_resource type="Resource" id="v_washer_c010"]
script = ExtResource("2")
text = "Was hast du da?"
conditions = Array[String](["shop_open:washer"])
actions = Array[String](["open_shop:washer"])

[sub_resource type="Resource" id="v_washer_c011"]
script = ExtResource("2")
text = "[Auftrag] Totenhemden"
next = &"o_o_liesel_gowns"
conditions = Array[String](["order_offerable:o_liesel_gowns"])

[sub_resource type="Resource" id="v_washer_c012"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Totenhemden"
next = &"t_o_liesel_gowns"
conditions = Array[String](["order_ready:o_liesel_gowns"])
actions = Array[String](["order_turn_in:o_liesel_gowns"])

[sub_resource type="Resource" id="v_washer_c013"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Garn"
next = &"t_ob_yarn"
conditions = Array[String](["order_ready:ob_yarn"])
actions = Array[String](["order_turn_in:ob_yarn"])

[sub_resource type="Resource" id="v_washer_c014"]
script = ExtResource("2")
text = "Du wäschst die Toten …"
next = &"washing"
conditions = Array[String](["rel_tier:washer:trusted", "village_open_days_gte:10", "!clue_known:c_v_washing"])

[sub_resource type="Resource" id="v_washer_c015"]
script = ExtResource("2")
text = "Kaspar war nicht der aus dem Moor."
next = &"kaspar"
conditions = Array[String](["flag:insight_not_lorenz", "village_open_days_gte:10", "!clue_known:c_v_washing"])

[sub_resource type="Resource" id="v_washer_c016"]
script = ExtResource("2")
text = "Erzähl von Wiebke Hagedorn."
next = &"about_wiebke"
conditions = Array[String](["!alive:oldwoman"])

[sub_resource type="Resource" id="v_washer_c017"]
script = ExtResource("2")
text = "Wer hält Totenwache?"
next = &"wake"

[sub_resource type="Resource" id="v_washer_c018"]
script = ExtResource("2")
text = "Ich hab dir etwas mitgebracht."
actions = Array[String](["open_gifts:washer"])

[sub_resource type="Resource" id="v_washer_c019"]
script = ExtResource("2")
text = "Auf Wiedersehen."
next = &"bye"

[sub_resource type="Resource" id="v_washer_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "Na?"
choices = Array[ExtResource("2")]([SubResource("v_washer_c010"), SubResource("v_washer_c011"), SubResource("v_washer_c012"), SubResource("v_washer_c013"), SubResource("v_washer_c014"), SubResource("v_washer_c015"), SubResource("v_washer_c016"), SubResource("v_washer_c017"), SubResource("p8_menu_menu_01"), SubResource("p8_menu_menu_02"), SubResource("p8_menu_menu_03"), SubResource("p8_menu_menu_04"), SubResource("p8_menu_menu_05"), SubResource("p8_menu_menu_06"), SubResource("p8_menu_menu_07"), SubResource("p8_menu_menu_08"), SubResource("p8_menu_menu_09"), SubResource("p8_menu_menu_10"), SubResource("p8_menu_menu_11"), SubResource("p8_menu_menu_12"), SubResource("p8_menu_menu_13"), SubResource("p8_menu_menu_14"), SubResource("p8_menu_menu_15"), SubResource("p8_menu_menu_16"), SubResource("p8_menu_menu_17"), SubResource("v_washer_c018"), SubResource("v_washer_c019")])

[sub_resource type="Resource" id="v_washer_c020"]
script = ExtResource("2")
text = "(Schweigen)"
next = &"menu"
actions = Array[String](["add_clue:c_v_washing"])

[sub_resource type="Resource" id="v_washer_node_washing"]
script = ExtResource("1")
id = &"washing"
text = "Was ich gesehen hab? Das Zeichen. Den Ring mit den drei Strichen, über dem Herzen. Seit dem Winter, als die Fähre umgekippt ist. Ich hab es Lorenz gesagt, jedes Mal. Er hat genickt und es aufgeschrieben. Seit er fort ist, sag ich es keinem mehr. Ich schreib die Namen in mein Gesangbuch. Hinten, wo keiner singt."
choices = Array[ExtResource("2")]([SubResource("v_washer_c020")])

[sub_resource type="Resource" id="v_washer_c021"]
script = ExtResource("2")
text = "Ich frage."
next = &"menu"
actions = Array[String](["add_clue:c_v_washing"])

[sub_resource type="Resource" id="v_washer_node_kaspar"]
script = ExtResource("1")
id = &"kaspar"
text = "Woher weißt du das? … Dann lebt er? Nein. Sag nichts. Wenn du es weißt, dann weißt du auch das andere. Ich hab das Zeichen gesehen, Totengräber, seit der Fähre, an allen, die es hatten. Ich hab es Lorenz gemeldet. Und jetzt schreib ich die Namen in mein Gesangbuch, weil keiner mehr da ist, der fragt."
choices = Array[ExtResource("2")]([SubResource("v_washer_c021")])

[sub_resource type="Resource" id="v_washer_c022"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_about_wiebke"]
script = ExtResource("1")
id = &"about_wiebke"
text = "Ich hab sie gewaschen. Sie war leicht wie ein Vogel und hatte den Mohn noch in der Hand. Das Zeichen hatte sie auch. Frisch. Sie hat es gewusst, Totengräber. Sie hat mich vor drei Wochen gefragt, ob es weh tut. Ich hab gesagt: Das Sterben nicht. Das Warten."
choices = Array[ExtResource("2")]([SubResource("v_washer_c022")])

[sub_resource type="Resource" id="v_washer_c023"]
script = ExtResource("2")
text = "Meistens?"
next = &"wake_more"

[sub_resource type="Resource" id="v_washer_c024"]
script = ExtResource("2")
text = "Verstehe."
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_wake"]
script = ExtResource("1")
id = &"wake"
text = "Ich. Wer sonst. Neun bis zwölf sitz ich bei denen, die gestern gegangen sind. Mittags sitz ich hier. Der Pfarrer kommt vorher, der Quast kommt vorher. Ich komm nachher. So ist die Reihenfolge, Totengräber. Die stimmt meistens."
choices = Array[ExtResource("2")]([SubResource("v_washer_c023"), SubResource("v_washer_c024")])

[sub_resource type="Resource" id="v_washer_c025"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_wake_more"]
script = ExtResource("1")
id = &"wake_more"
text = "Ich red nicht drüber. Spinn du mal einen Faden, wenn dir einer dauernd über die Schulter schaut."
choices = Array[ExtResource("2")]([SubResource("v_washer_c025")])

[sub_resource type="Resource" id="v_washer_c026"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_liesel_gowns_yes"
actions = Array[String](["order_accept:o_liesel_gowns"])

[sub_resource type="Resource" id="v_washer_c027"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_o_o_liesel_gowns"]
script = ExtResource("1")
id = &"o_o_liesel_gowns"
text = "Zwei Totenhemden. Für die, die nicht zu dir hinaufkommen. Die Ertrunkenen, die keiner findet, und die, die in der Stadt sterben und hier begraben werden wollen. Die kriegen nur ein Tuch. Das reicht nicht."
choices = Array[ExtResource("2")]([SubResource("v_washer_c026"), SubResource("v_washer_c027")])

[sub_resource type="Resource" id="v_washer_c028"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_o_o_liesel_gowns_yes"]
script = ExtResource("1")
id = &"o_o_liesel_gowns_yes"
text = "Sechs Tage. Und mach die Nähte ordentlich. Ich seh es."
choices = Array[ExtResource("2")]([SubResource("v_washer_c028")])

[sub_resource type="Resource" id="v_washer_c029"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_t_o_liesel_gowns"]
script = ExtResource("1")
id = &"t_o_liesel_gowns"
text = "Gut genäht. Für einen Mann. Danke. Sag es keinem."
choices = Array[ExtResource("2")]([SubResource("v_washer_c029")])

[sub_resource type="Resource" id="v_washer_c030"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_washer_node_t_ob_yarn"]
script = ExtResource("1")
id = &"t_ob_yarn"
text = "Gutes Garn. Die Spinnstube hat wieder zu tun."
choices = Array[ExtResource("2")]([SubResource("v_washer_c030")])

[sub_resource type="Resource" id="v_washer_c031"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_washer_node_bye"]
script = ExtResource("1")
id = &"bye"
text = "Komm wieder. Ich spinne sowieso. Mit dir geht es schneller."
choices = Array[ExtResource("2")]([SubResource("v_washer_c031")])
conditions = Array[String](["rel_tier:washer:friend"])
fallback_next = &"bye_plain"

[sub_resource type="Resource" id="v_washer_c032"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_washer_node_bye_plain"]
script = ExtResource("1")
id = &"bye_plain"
text = "Geh. Und tritt nicht aufs Garn."
choices = Array[ExtResource("2")]([SubResource("v_washer_c032")])

