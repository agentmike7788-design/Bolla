[sub_resource type="Resource" id="p8_menu_menu_13"]
script = ExtResource("2")
text = "[Gegengefallen] Hier ist es: Garn für den Laden"
next = &"t_of_mangold_return_2"
conditions = Array[String](["order_ready:of_mangold_return_2"])
