next = &"story_2_turn_in"
conditions = Array[String](["order_ready:of_mangold_2"])
actions = Array[String](["order_turn_in:of_mangold_2"])

[sub_resource type="Resource" id="p8_p8_hill_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_hill"]
script = ExtResource("1")
id = &"p8_hill"
text = "Ich bin bei Mutter. Fünf Minuten, dann muss ich zurück, der Laden ist zu, und ein geschlossener Laden kostet."
choices = Array[ExtResource("2")]([SubResource("p8_p8_hill_c01")])
conditions = Array[String](["region:graveyard"])
fallback_next = &"start"
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="p8_story_1_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_1_yes"
actions = Array[String](["step_accept:grocer", "give_item:flower_seedlings:1"])

[sub_resource type="Resource" id="p8_story_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1"]
script = ExtResource("1")
id = &"story_1"
text = "Setz Mutter Christrosen aufs Grab und halt sie frisch, bis ich wiederkomme. Den Topf geb ich Ihnen, ich rechne ihn nicht an. Das heißt, ich rechne ihn an, aber nicht Ihnen."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_c01"), SubResource("p8_story_1_c02")])

[sub_resource type="Resource" id="p8_story_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_yes"]
script = ExtResource("1")
id = &"story_1_yes"
text = "Christrosen. Die blühen, wenn sonst nichts blüht. Mutter hat das gemocht. Sie hat alles gemocht, was sich nicht nach den anderen richtet."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_yes_c01")])

[sub_resource type="Resource" id="p8_story_1_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_done"]
script = ExtResource("1")
id = &"story_1_done"
text = "Sie waren frisch, als ich kam. Ich hab gezählt: elf Blüten. Mutter hätte zwölf gesagt, aus Prinzip."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_done_c01")])

[sub_resource type="Resource" id="p8_story_2_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_2_yes"
actions = Array[String](["step_accept:grocer"])

[sub_resource type="Resource" id="p8_story_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2"]
script = ExtResource("1")
id = &"story_2"
text = "Im Buch meiner Mutter stehen noch Schulden. Von Leuten, die längst tot sind. Ich will die Seiten am Lichtgang verbrennen. Aber erst will ich wissen, wer davon oben liegt. Schreiben Sie mir die Namen aus Ihrem Register ab."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_c01"), SubResource("p8_story_2_c02")])

[sub_resource type="Resource" id="p8_story_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_yes"]
script = ExtResource("1")
id = &"story_2_yes"
text = "Mit Tinte, bitte. Bleistift verwischt. Bei Schulden darf nichts verwischen, auch nicht beim Verbrennen."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_yes_c01")])

[sub_resource type="Resource" id="p8_story_2_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_done"]
script = ExtResource("1")
id = &"story_2_done"
text = "Ich hab die Seiten verbrannt. Sie haben schlecht gebrannt, das Papier war gut. Mutter hat nie an Papier gespart, nur an sich."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_done_c01")])

[sub_resource type="Resource" id="p8_story_3_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_3_yes"
actions = Array[String](["step_accept:grocer"])

[sub_resource type="Resource" id="p8_story_3_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3"]
script = ExtResource("1")
id = &"story_3"
text = "Drei Töpfe Christrosen. Für drei Gräber, zu denen keiner kommt. Halten Sie sie frisch bis zum dritten Morgen. Ich zahle die Töpfe. Das schreib ich nirgends hin."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_c01"), SubResource("p8_story_3_c02")])

[sub_resource type="Resource" id="p8_story_3_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_yes"]
script = ExtResource("1")
id = &"story_3_yes"
text = "Drei. Mehr hab ich nicht. Mehr sollte auch keiner brauchen."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_yes_c01")])

[sub_resource type="Resource" id="p8_story_3_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_done"]
script = ExtResource("1")
id = &"story_3_done"
text = "Drei Gräber mit Christrosen, und keiner weiß, von wem. So ist es richtig. Wenn man es weiß, ist es ein Geschäft."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_done_c01")])

[sub_resource type="Resource" id="p8_story_cross_c01"]
script = ExtResource("2")
text = "Morgen also."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_cross"]
script = ExtResource("1")
id = &"story_cross"
text = "Heute nicht, Totengräber. Morgen. Heute rechne ich nur."
choices = Array[ExtResource("2")]([SubResource("p8_story_cross_c01")])

[sub_resource type="Resource" id="p8_listen_c01"]
script = ExtResource("2")
text = "(Schweigen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_listen"]
script = ExtResource("1")
id = &"listen"
text = "Heute vor elf Jahren hat Mutter den Laden zugemacht. Für immer, meine ich. Ich hab ihn am nächsten Morgen wieder aufgemacht, um sieben, wie sie. Das war das Einzige, was ich konnte. … Danke. Sie hören zu wie einer, der nichts kauft."
choices = Array[ExtResource("2")]([SubResource("p8_listen_c01")])

[sub_resource type="Resource" id="p8_favor_c01"]
script = ExtResource("2")
text = "Ja, bestell es."
next = &"favor_done"
actions = Array[String](["favor_use:grocer"])

[sub_resource type="Resource" id="p8_favor_c02"]
script = ExtResource("2")
text = "Ein andermal."
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor"]
script = ExtResource("1")
id = &"favor"
text = "Etwas aus Hannes Kiepe? Außerhalb ihres Tages? Ich bestelle es Ihnen. Morgen früh liegt es bei mir. Zu ihrem Preis."
choices = Array[ExtResource("2")]([SubResource("p8_favor_c01"), SubResource("p8_favor_c02")])

[sub_resource type="Resource" id="p8_favor_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor_done"]
script = ExtResource("1")
id = &"favor_done"
text = "Ich schreibe es Hanne auf. Morgen früh liegt es bei mir, zu ihrem Preis, nicht zu meinem. Das tut weh, aber gut."
choices = Array[ExtResource("2")]([SubResource("p8_favor_done_c01")])

[sub_resource type="Resource" id="p8_o_of_mangold_return_1_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_mangold_return_1_yes"
actions = Array[String](["order_accept:of_mangold_return_1"])

[sub_resource type="Resource" id="p8_o_of_mangold_return_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_mangold_return_1"]
script = ExtResource("1")
id = &"o_of_mangold_return_1"
text = "Acht Bund Kräuter. Die Stadt will sie, und ich will die Stadt."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_mangold_return_1_c01"), SubResource("p8_o_of_mangold_return_1_c02")])

[sub_resource type="Resource" id="p8_o_of_mangold_return_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_mangold_return_1_yes"]
script = ExtResource("1")
id = &"o_of_mangold_return_1_yes"
text = "Drei Tage. Ich zähle."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_mangold_return_1_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_mangold_return_1_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_mangold_return_1"]
script = ExtResource("1")
id = &"t_of_mangold_return_1"
text = "Acht Bund. Ich hab nachgezählt. Acht."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_mangold_return_1_c01")])

[sub_resource type="Resource" id="p8_o_of_mangold_return_2_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_mangold_return_2_yes"
actions = Array[String](["order_accept:of_mangold_return_2"])

[sub_resource type="Resource" id="p8_o_of_mangold_return_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_mangold_return_2"]
script = ExtResource("1")
id = &"o_of_mangold_return_2"
text = "Vier Strang Garn. Meins ist alle, und die Dorn spinnt nur für Tote."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_mangold_return_2_c01"), SubResource("p8_o_of_mangold_return_2_c02")])

[sub_resource type="Resource" id="p8_o_of_mangold_return_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_mangold_return_2_yes"]
script = ExtResource("1")
id = &"o_of_mangold_return_2_yes"
text = "Gut."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_mangold_return_2_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_mangold_return_2_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_mangold_return_2"]
script = ExtResource("1")
id = &"t_of_mangold_return_2"
text = "Vier Strang. Schönes Garn. Fast zu schön zum Verkaufen."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_mangold_return_2_c01")])

[sub_resource type="Resource" id="p8_dance_c01"]
script = ExtResource("2")
text = "(Zurück an den Tisch)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_dance"]
script = ExtResource("1")
id = &"dance"
text = "Einen Tanz? Mit dem Totengräber? Na gut. Aber Sie zählen nicht mit. Ich zähle."
choices = Array[ExtResource("2")]([SubResource("p8_dance_c01")])

[sub_resource type="Resource" id="p8_story_2_turn_in_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_turn_in"]
script = ExtResource("1")
id = &"story_2_turn_in"
text = "Neun Namen. Sieben davon im Buch. Zwei haben bar gezahlt. Die zwei hat Mutter nie gemocht."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_turn_in_c01")])

[sub_resource type="Resource" id="v_grocer_c001"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_start"]
script = ExtResource("1")
id = &"start"
text = "Mangold, Theres, geborene Mahn, Kolonialwaren und Buntes. Sie sind der Totengräber. Drei Ellen Leinen die Woche, sagt Faulhaber, macht neun Münzen, macht im Jahr – na, das rechne ich später. Was darf es sein?"
choices = Array[ExtResource("2")]([SubResource("v_grocer_c001")])
conditions = Array[String](["!met:grocer"])
fallback_next = &"greet_disreputable"
actions = Array[String](["meet:grocer", "talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c002"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_greet_disreputable"]
script = ExtResource("1")
id = &"greet_disreputable"
text = "Ach, Sie. Gezählt wird bei mir vor dem Tresen, nicht dahinter. Und bar."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c002")])
conditions = Array[String](["rep_tier:disreputable"])
fallback_next = &"greet_unremarkable"
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c003"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_greet_unremarkable"]
script = ExtResource("1")
id = &"greet_unremarkable"
text = "Guten Tag. Leinen, Samen, Kerzen, Buntes. Was darf es sein?"
choices = Array[ExtResource("2")]([SubResource("v_grocer_c003")])
conditions = Array[String](["rep_tier:unremarkable"])
fallback_next = &"greet_respected"
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c004"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_greet_respected"]
script = ExtResource("1")
id = &"greet_respected"
text = "Der Totengräber! Ich habe Leinen frisch, sechs Ellen, und zwei davon lege ich Ihnen zurück, ohne Aufschlag, das sage ich nicht jedem."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c004")])
conditions = Array[String](["rep_tier:respected"])
fallback_next = &"greet_esteemed"
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c005"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_greet_esteemed"]
script = ExtResource("1")
id = &"greet_esteemed"
text = "Herr Totengräber, endlich. Ich habe extra Wachs kommen lassen, vier Stück, eins mehr als sonst. Für Sie rechne ich es gerade."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c005")])
conditions = Array[String](["rep_tier:esteemed"])
fallback_next = &"greet_renowned"
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c006"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_greet_renowned"]
script = ExtResource("1")
id = &"greet_renowned"
text = "Sie! Kommen Sie, kommen Sie. Für Sie mache ich die Ladentür auf statt nur das Fenster. Das gibt es sonst nur zur Kirchweih."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c006")])
actions = Array[String](["talked:grocer"])

[sub_resource type="Resource" id="v_grocer_c007"]
script = ExtResource("2")
text = "Was hast du da?"
conditions = Array[String](["shop_open:grocer"])
actions = Array[String](["open_shop:grocer"])

[sub_resource type="Resource" id="v_grocer_c008"]
script = ExtResource("2")
text = "[Auftrag] Ein Stein für die Mutter"
next = &"o_o_mangold_stone"
conditions = Array[String](["order_offerable:o_mangold_stone"])

[sub_resource type="Resource" id="v_grocer_c009"]
script = ExtResource("2")
text = "Was ist „Buntes“?"
next = &"buntes"

[sub_resource type="Resource" id="v_grocer_c010"]
script = ExtResource("2")
text = "Du warst mal eine Mahn?"
next = &"mahn"

[sub_resource type="Resource" id="v_grocer_c011"]
script = ExtResource("2")
text = "Ich hab dir etwas mitgebracht."
actions = Array[String](["open_gifts:grocer"])

[sub_resource type="Resource" id="v_grocer_c012"]
script = ExtResource("2")
text = "Auf Wiedersehen."
next = &"bye"

[sub_resource type="Resource" id="v_grocer_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "Eins, zwei – ja? Ich höre."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c007"), SubResource("v_grocer_c008"), SubResource("v_grocer_c009"), SubResource("v_grocer_c010"), SubResource("p8_menu_menu_01"), SubResource("p8_menu_menu_02"), SubResource("p8_menu_menu_03"), SubResource("p8_menu_menu_04"), SubResource("p8_menu_menu_05"), SubResource("p8_menu_menu_06"), SubResource("p8_menu_menu_07"), SubResource("p8_menu_menu_08"), SubResource("p8_menu_menu_09"), SubResource("p8_menu_menu_10"), SubResource("p8_menu_menu_11"), SubResource("p8_menu_menu_12"), SubResource("p8_menu_menu_13"), SubResource("p8_menu_menu_14"), SubResource("p8_menu_menu_15"), SubResource("v_grocer_c011"), SubResource("v_grocer_c012")])

[sub_resource type="Resource" id="v_grocer_c013"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_mangold_stone_yes"
actions = Array[String](["order_accept:o_mangold_stone"])

[sub_resource type="Resource" id="v_grocer_c014"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_o_o_mangold_stone"]
script = ExtResource("1")
id = &"o_o_mangold_stone"
text = "Dorothee Mahn. Meine Mutter. Liegt bei Ihnen im alten Hof, und auf dem Stein steht nichts mehr, was man lesen kann. Eine Stele mit Mohn, und es soll etwas darauf stehen. Ich rechne es Ihnen nicht vor. Ich bezahle es. Sechs Tage, dann ist ihr Namenstag."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c013"), SubResource("v_grocer_c014")])

[sub_resource type="Resource" id="v_grocer_c015"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_o_o_mangold_stone_yes"]
script = ExtResource("1")
id = &"o_o_mangold_stone_yes"
text = "Danke. Ich trage es mir ein. Nein, nicht ins Kassenbuch. In das andere."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c015")])

[sub_resource type="Resource" id="v_grocer_c016"]
script = ExtResource("2")
text = "Verstehe."
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_buntes"]
script = ExtResource("1")
id = &"buntes"
text = "Buntes ist alles, was nicht Mehl, Salz, Leinen oder Kerze ist. Bänder, Knöpfe, ein Glas mit Zuckerzeug, eine Feder, die keiner will. Was ich nicht kenne, ist Buntes. Präparatgläser zum Beispiel. Sehr bunt, Herr Totengräber."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c016")])

[sub_resource type="Resource" id="v_grocer_c017"]
script = ExtResource("2")
text = "Sie hätte dich gemocht."
next = &"menu"

[sub_resource type="Resource" id="v_grocer_node_mahn"]
script = ExtResource("1")
id = &"mahn"
text = "Mahn, ja. Die Mahns hatten den Laden vor mir. Mutter hat gerechnet, wie ich rechne, nur schneller. Sie hätte gesagt: Theres, du redest zu viel und verkaufst zu wenig. Beides stimmt."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c017")])

[sub_resource type="Resource" id="v_grocer_c018"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_grocer_node_bye"]
script = ExtResource("1")
id = &"bye"
text = "Kommen Sie bald wieder. Ich lege Ihnen etwas zurück. Was, weiß ich noch nicht, aber es wird bunt."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c018")])
conditions = Array[String](["rel_tier:grocer:friend"])
fallback_next = &"bye_plain"

[sub_resource type="Resource" id="v_grocer_c019"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_grocer_node_bye_plain"]
script = ExtResource("1")
id = &"bye_plain"
text = "Auf Wiedersehen. Und bringen Sie die Körbe zurück, die zählen auch."
choices = Array[ExtResource("2")]([SubResource("v_grocer_c019")])

