[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_node.gd" id="1"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_choice.gd" id="2"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_data.gd" id="3"]

[sub_resource type="Resource" id="kin_ott_first_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_first"]
script = ExtResource("1")
id = &"first"
text = "War er schwer? Ich mein nicht beim Tragen. Ich mein am Ende. … Sie müssen nicht antworten. Ich frag nur, weil keiner mir was sagt. Liesel sagt, er hat ruhig geschlafen. Liesel sagt das immer."
choices = Array[ExtResource("2")]([SubResource("kin_ott_first_c01")])
conditions = Array[String](["!flag:p8_met_kin_ott"])
fallback_next = &"greet"
actions = Array[String](["set_flag:p8_met_kin_ott"])

[sub_resource type="Resource" id="kin_ott_greet_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_greet"]
script = ExtResource("1")
id = &"greet"
text = "Sie schon wieder. Gut. Sie sind der Einzige, der mir antwortet, wenn ich frag."
choices = Array[ExtResource("2")]([SubResource("kin_ott_greet_c01")])

[sub_resource type="Resource" id="kin_ott_menu_c01"]
script = ExtResource("2")
text = "[Trinkgeld] …"
next = &"tip"
conditions = Array[String](["tip_due"])
actions = Array[String](["tip_hand"])

[sub_resource type="Resource" id="kin_ott_menu_c02"]
script = ExtResource("2")
text = "[Wunsch] Kann ich etwas für das Grab tun?"
next = &"wish"
conditions = Array[String](["wish_offerable"])
actions = Array[String](["wish_offer"])

[sub_resource type="Resource" id="kin_ott_menu_c03"]
script = ExtResource("2")
text = "Wer liegt hier?"
next = &"who"

[sub_resource type="Resource" id="kin_ott_menu_c04"]
script = ExtResource("2")
text = "Ich lass Sie allein."

[sub_resource type="Resource" id="kin_ott_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "(Gesa wartet.)"
choices = Array[ExtResource("2")]([SubResource("kin_ott_menu_c01"), SubResource("kin_ott_menu_c02"), SubResource("kin_ott_menu_c03"), SubResource("kin_ott_menu_c04")])

[sub_resource type="Resource" id="kin_ott_wish_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"wish_yes"
actions = Array[String](["wish_accept"])

[sub_resource type="Resource" id="kin_ott_wish_c02"]
script = ExtResource("2")
text = "Ich kann es nicht versprechen."
next = &"wish_no"

[sub_resource type="Resource" id="kin_ott_node_wish"]
script = ExtResource("1")
id = &"wish"
text = "Strohblumen hab ich gebracht. Die halten länger als er. Machen Sie, dass sie stehen bleiben? Eine Vase, oder ein Stein dahinter. Und sagen Sie mir, wann der Doktor zuletzt da war. Nein. Sagen Sie's mir nicht."
choices = Array[ExtResource("2")]([SubResource("kin_ott_wish_c01"), SubResource("kin_ott_wish_c02")])

[sub_resource type="Resource" id="kin_ott_wish_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_wish_yes"]
script = ExtResource("1")
id = &"wish_yes"
text = "Danke. Ich frag nicht, wie. Ich frag sonst alles."
choices = Array[ExtResource("2")]([SubResource("kin_ott_wish_yes_c01")])

[sub_resource type="Resource" id="kin_ott_wish_no_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_wish_no"]
script = ExtResource("1")
id = &"wish_no"
text = "Wenigstens sagen Sie es ehrlich."
choices = Array[ExtResource("2")]([SubResource("kin_ott_wish_no_c01")])

[sub_resource type="Resource" id="kin_ott_tip_c01"]
script = ExtResource("2")
text = "Danke."
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_tip"]
script = ExtResource("1")
id = &"tip"
text = "Für Sie. Vater hätte gesagt, das ist zu viel. Vater hat nie was zu viel gegeben, nur zu wenig Zeit."
choices = Array[ExtResource("2")]([SubResource("kin_ott_tip_c01")])

[sub_resource type="Resource" id="kin_ott_who_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_ott_node_who"]
script = ExtResource("1")
id = &"who"
text = "Mein Vater. Gerhard Ott. Vierundsiebzig. Drei waren da, in der letzten Woche. Der Pfarrer, der Doktor und die Dorn. Ich hab sie alle reingelassen. Ich weiß nicht, ob man das darf, sich zu fragen, warum."
choices = Array[ExtResource("2")]([SubResource("kin_ott_who_c01")])

[resource]
script = ExtResource("3")
id = &"kin_ott"
speaker_name = "Gesa Ott"
start_node = &"first"
nodes = Array[ExtResource("1")]([SubResource("kin_ott_node_first"), SubResource("kin_ott_node_greet"), SubResource("kin_ott_node_menu"), SubResource("kin_ott_node_wish"), SubResource("kin_ott_node_wish_yes"), SubResource("kin_ott_node_wish_no"), SubResource("kin_ott_node_tip"), SubResource("kin_ott_node_who")])
