[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_node.gd" id="1_0vtyj"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_choice.gd" id="2_cdonk"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_data.gd" id="3_0t3rl"]

[sub_resource type="Resource" id="p5_choice_01"]
script = ExtResource("2_cdonk")
text = "Zeig her."
actions = Array[String](["open_panel:trader"])

[sub_resource type="Resource" id="p5_choice_02"]
script = ExtResource("2_cdonk")
text = "Was kostet es?"
next = &"p5_gold_price"

[sub_resource type="Resource" id="p5_choice_03"]
script = ExtResource("2_cdonk")
text = "Gute Nacht, Ilse."
next = &"goodbye"

[sub_resource type="Resource" id="node_p5_gold"]
script = ExtResource("1_0vtyj")
id = &"p5_gold"
text = "Ich hab etwas Neues in der Kiepe. Blattgold, dünn wie ein Atemzug. Aus dem Nachlass eines Vergolders. Er hätte gewollt, dass es glänzt."
choices = Array[ExtResource("2_cdonk")]([SubResource("p5_choice_01"), SubResource("p5_choice_02"), SubResource("p5_choice_03")])
conditions = Array[String](["flag:workshop_open", "flag:trader_tools_given", "!flag:remark_gold"])
fallback_next = &"greet_devout"
actions = Array[String](["set_flag:remark_gold", "set_flag_night:trader_greeted", "trader_talked"])

[sub_resource type="Resource" id="p5_choice_04"]
script = ExtResource("2_cdonk")
text = "Etwas anderes …"
next = &"menu"

[sub_resource type="Resource" id="node_p5_gold_price"]
script = ExtResource("1_0vtyj")
id = &"p5_gold_price"
text = "Sechs Münzen das Blatt, zwei in jeder Nacht. Mehr hat er nicht hinterlassen, und mehr trag ich nicht durchs Moor."
choices = Array[ExtResource("2_cdonk")]([SubResource("p5_choice_04")])

[sub_resource type="Resource" id="choice_001"]
script = ExtResource("2_cdonk")
text = "Du hast den Zettel an meine Tür gesteckt."
next = &"first_note"

[sub_resource type="Resource" id="choice_002"]
script = ExtResource("2_cdonk")
text = "Was willst du von mir?"
next = &"first_note"

[sub_resource type="Resource" id="node_first_meet"]
script = ExtResource("1_0vtyj")
id = &"first_meet"
text = "Da bist du ja. Ich dachte mir, dass du kommst. Die Neuen kommen immer in der ersten Nacht, aus Neugier – und in der zweiten aus einem anderen Grund. Ilse Kranich. Unten im Dorf sagen sie Kranichfrau, wegen der Feder. Ich habe nichts dagegen. Kraniche ziehen auch nachts."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_001"), SubResource("choice_002")])
conditions = Array[String](["!flag:trader_met"])
fallback_next = &"gift_retry"
actions = Array[String](["set_flag:trader_met", "set_flag_night:trader_greeted", "trader_talked"])

[sub_resource type="Resource" id="choice_003"]
script = ExtResource("2_cdonk")
text = "Ich nehme den Toten nichts."
next = &"first_gift"
actions = Array[String](["trader_tools"])

[sub_resource type="Resource" id="choice_004"]
script = ExtResource("2_cdonk")
text = "Was zahlst du?"
next = &"first_gift"
actions = Array[String](["trader_tools"])

[sub_resource type="Resource" id="node_first_note"]
script = ExtResource("1_0vtyj")
id = &"first_note"
text = "Wollen? Nichts. Ich nehme ab, was andere nicht behalten wollen. Haar für die Perückenmacher in der Stadt, Zähne für die Zahnbrecher, Leinen aus Nachlässen. Die Stillen brauchen es nicht mehr. Ob du es ihnen nimmst, ist deine Sache, nicht meine. Ich feilsche nicht, und ich frage nicht, woher etwas kommt."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_003"), SubResource("choice_004")])

[sub_resource type="Resource" id="choice_005"]
script = ExtResource("2_cdonk")
text = "Zeig mir, was du hast."
actions = Array[String](["open_panel:trader"])

[sub_resource type="Resource" id="choice_006"]
script = ExtResource("2_cdonk")
text = "Ich habe noch Fragen."
next = &"menu"

[sub_resource type="Resource" id="choice_007"]
script = ExtResource("2_cdonk")
text = "Gute Nacht, Ilse."
next = &"goodbye"

[sub_resource type="Resource" id="node_first_gift"]
script = ExtResource("1_0vtyj")
id = &"first_gift"
text = "Wie du willst. Nimm trotzdem das hier: eine Schere und eine Zange, gut geschliffen. Einer hat sie mir dagelassen, der sie nicht mehr brauchte. Man kann sie auch für anderes nehmen. Man tut es nur selten. Ich stehe jede Nacht hier, von elf bis drei. Leinen und Wacholder habe ich immer, billiger als der Kutscher. Sag es ihm nicht, er ist empfindlich."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_005"), SubResource("choice_006"), SubResource("choice_007")])
conditions = Array[String](["flag:trader_tools_given"])
fallback_next = &"first_gift_full"

[sub_resource type="Resource" id="choice_008"]
script = ExtResource("2_cdonk")
text = "Ich komme wieder."
next = &"menu"

[sub_resource type="Resource" id="node_first_gift_full"]
script = ExtResource("1_0vtyj")
id = &"first_gift_full"
text = "Deine Taschen sind voll, Totengräber. Komm wieder, wenn du Platz hast. Ich habe Zeit."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_008")])

[sub_resource type="Resource" id="choice_009"]
script = ExtResource("2_cdonk")
text = "Ja, gib her."
next = &"first_gift"
actions = Array[String](["trader_tools"])

[sub_resource type="Resource" id="choice_010"]
script = ExtResource("2_cdonk")
text = "Noch nicht."
next = &"menu"

[sub_resource type="Resource" id="node_gift_retry"]
script = ExtResource("1_0vtyj")
id = &"gift_retry"
text = "Hast du jetzt Platz? Die Schere und die Zange liegen noch in meiner Kiepe. Leichter werden sie nicht."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_009"), SubResource("choice_010")])
conditions = Array[String](["flag:trader_met", "!flag:trader_tools_given"])
fallback_next = &"p5_gold"
actions = Array[String](["set_flag_night:trader_greeted", "trader_talked"])

[sub_resource type="Resource" id="choice_011"]
script = ExtResource("2_cdonk")
text = "Handeln."
actions = Array[String](["open_panel:trader"])

[sub_resource type="Resource" id="choice_012"]
script = ExtResource("2_cdonk")
text = "Wer bist du, Ilse?"
next = &"who"

[sub_resource type="Resource" id="choice_013"]
script = ExtResource("2_cdonk")
text = "Kanntest du den alten Totengräber?"
next = &"ask_lorenz"
