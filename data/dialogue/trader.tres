[sub_resource type="Resource" id="node_greet_callous"]
script = ExtResource("1_0vtyj")
id = &"greet_callous"
text = "Du bist schneller geworden. Das geht vielen so."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_032"), SubResource("choice_033"), SubResource("choice_034"), SubResource("choice_035"), SubResource("choice_036"), SubResource("choice_037"), SubResource("choice_038")])
