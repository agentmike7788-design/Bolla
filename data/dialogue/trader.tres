[sub_resource type="Resource" id="node_menu"]
script = ExtResource("1_0vtyj")
id = &"menu"
text = "Noch etwas? Ich habe Zeit. Die Stillen auch."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_046"), SubResource("choice_047"), SubResource("choice_048"), SubResource("choice_049"), SubResource("choice_050"), SubResource("choice_051"), SubResource("choice_052")])

[sub_resource type="Resource" id="choice_053"]
script = ExtResource("2_cdonk")
text = "Was machst du mit dem, was du kaufst?"
next = &"who_goods"

[sub_resource type="Resource" id="choice_054"]
script = ExtResource("2_cdonk")
text = "Hast du keine Angst, nachts im Moor?"
next = &"who_night"

[sub_resource type="Resource" id="choice_055"]
script = ExtResource("2_cdonk")
text = "Schon gut."
next = &"menu"

[sub_resource type="Resource" id="node_who"]
script = ExtResource("1_0vtyj")
id = &"who"
text = "Eine, die nachts geht, weil am Tag zu viele Leute auf den Wegen sind. Ich ziehe von Dorf zu Dorf, über die Moorwege, seit ich so alt war wie du jetzt. Vielleicht länger. Man zählt die Jahre nicht mehr, wenn man sie im Dunkeln verbringt."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_053"), SubResource("choice_054"), SubResource("choice_055")])

[sub_resource type="Resource" id="choice_056"]
script = ExtResource("2_cdonk")
text = "Verstehe."
next = &"menu"

[sub_resource type="Resource" id="node_who_goods"]
script = ExtResource("1_0vtyj")
id = &"who_goods"
text = "Ich verkaufe es weiter. Die feinen Damen in der Stadt tragen die Zöpfe unserer Mägde und wissen es nicht. Ist das schlimm? Die Stillen frieren nicht am Kopf. Was sonst aus meiner Kiepe wird, geht dich nichts an. Nicht böse gemeint."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_056")])

[sub_resource type="Resource" id="choice_057"]
script = ExtResource("2_cdonk")
text = "Ich hoffe nicht."
next = &"menu"

[sub_resource type="Resource" id="node_who_night"]
script = ExtResource("1_0vtyj")
id = &"who_night"
text = "Angst? Im Moor sind die Lebenden das Gefährliche, und die schlafen nachts. Die anderen kennen mich. Sie gehen ein Stück neben mir her und sagen nichts. Man gewöhnt sich an stille Gesellschaft. Du wirst es auch noch."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_057")])

[sub_resource type="Resource" id="choice_058"]
script = ExtResource("2_cdonk")
text = "Warum wollte er das wissen?"
next = &"ask_lorenz_more"

[sub_resource type="Resource" id="choice_059"]
script = ExtResource("2_cdonk")
text = "Er lebt, Ilse."
next = &"lorenz_alive"
conditions = Array[String](["flag:insight_not_lorenz"])

[sub_resource type="Resource" id="choice_060"]
script = ExtResource("2_cdonk")
text = "Danke."
next = &"menu"

[sub_resource type="Resource" id="node_ask_lorenz"]
script = ExtResource("1_0vtyj")
id = &"ask_lorenz"
text = "Lorenz? Er hat mir nie etwas verkauft. Er hat mir Tee gekocht und gefragt, wer im Dorf die Kranken besucht. Dann hat er aufgeschrieben, was ich sagte."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_058"), SubResource("choice_059"), SubResource("choice_060")])
actions = Array[String](["add_clue:c_trader_lorenz"])

[sub_resource type="Resource" id="choice_061"]
script = ExtResource("2_cdonk")
text = "Danke, Ilse."
next = &"menu"

[sub_resource type="Resource" id="node_ask_lorenz_more"]
script = ExtResource("1_0vtyj")
id = &"ask_lorenz_more"
text = "Das habe ich ihn nicht gefragt. Wer so fragt, will keine Frage zurück. Er hatte eine Kladde mit braunem Einband und eine schräge Schrift, und er schrieb schnell, als liefe ihm etwas davon. Mehr weiß ich nicht. Und was ich weiß, ist nicht alles, was es gibt."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_061")])

[sub_resource type="Resource" id="choice_062"]
script = ExtResource("2_cdonk")
text = "Ich verstehe."
next = &"menu"

[sub_resource type="Resource" id="node_lorenz_alive"]
script = ExtResource("1_0vtyj")
id = &"lorenz_alive"
text = "So. … Wenn er lebt, dann weiß er, warum er nicht zurückkommt. Stör ihn nicht beim Graben."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_062")])

[sub_resource type="Resource" id="choice_063"]
script = ExtResource("2_cdonk")
text = "Wem?"
next = &"ask_marked_more"

[sub_resource type="Resource" id="choice_064"]
script = ExtResource("2_cdonk")
text = "Gut."
next = &"menu"

[sub_resource type="Resource" id="node_ask_marked"]
script = ExtResource("1_0vtyj")
id = &"ask_marked"
text = "Die mit dem Zeichen kaufe ich nicht. Die gehören schon jemandem. Frag mich nicht, wem."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_063"), SubResource("choice_064")])
actions = Array[String](["add_clue:c_trader_marked"])

[sub_resource type="Resource" id="choice_065"]
script = ExtResource("2_cdonk")
text = "Ich merke es mir."
next = &"menu"

[sub_resource type="Resource" id="node_ask_marked_more"]
script = ExtResource("1_0vtyj")
id = &"ask_marked_more"
text = "Ich sagte, frag mich nicht. … Du bist höflich, also bin ich es auch: Ich weiß es nicht. Ich weiß nur, dass man ihnen nichts nehmen soll. Nicht einmal ein Haar. Ihnen fehlt es dann nicht. Es fehlt dann jemand anderem, und der merkt es."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_065")])

[sub_resource type="Resource" id="choice_066"]
script = ExtResource("2_cdonk")
text = "Von wem hast du sie?"
next = &"ask_blossom_more"

[sub_resource type="Resource" id="choice_067"]
script = ExtResource("2_cdonk")
text = "Schon gut."
next = &"menu"

[sub_resource type="Resource" id="node_ask_blossom"]
script = ExtResource("1_0vtyj")
id = &"ask_blossom"
text = "Die hier? Eine Holunderblüte. Sie welkt nicht, wenn man sie richtig presst. Man bekommt sie geschenkt, und man gibt sie nicht zurück. … Du hast ein gutes Auge, Totengräber. Das ist nicht immer ein Geschenk."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_066"), SubResource("choice_067")])

[sub_resource type="Resource" id="choice_068"]
script = ExtResource("2_cdonk")
text = "Etwas anderes …"
next = &"menu"

[sub_resource type="Resource" id="node_ask_blossom_more"]
script = ExtResource("1_0vtyj")
id = &"ask_blossom_more"
text = "Von einem, der Tee gekocht hat. Jetzt ist es spät. Handeln wir, oder gehst du schlafen?"
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_068")])

[sub_resource type="Resource" id="choice_069"]
script = ExtResource("2_cdonk")
text = "(Gehen)"

[sub_resource type="Resource" id="node_goodbye"]
script = ExtResource("1_0vtyj")
id = &"goodbye"
text = "Gute Nacht, Totengräber. Grüß die Stillen von mir. Sie grüßen nicht zurück, aber sie merken es sich."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_069")])

