[sub_resource type="Resource" id="node_greet_hardhearted"]
script = ExtResource("1_0vtyj")
id = &"greet_hardhearted"
text = "Du hast gelernt, nicht hinzusehen. Ich hab's dir nicht beigebracht."
choices = Array[ExtResource("2_cdonk")]([SubResource("choice_039"), SubResource("choice_040"), SubResource("choice_041"), SubResource("choice_042"), SubResource("choice_043"), SubResource("choice_044"), SubResource("choice_045")])
conditions = Array[String](["piety_tier:hardhearted", "!flag_night:trader_greeted"])
fallback_next = &"menu"
actions = Array[String](["set_flag_night:trader_greeted", "trader_talked"])

