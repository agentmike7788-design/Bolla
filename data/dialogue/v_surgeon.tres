ce("p8_node_o_of_quast_return_1_yes"), SubResource("p8_node_t_of_quast_return_1"), SubResource("p8_node_o_of_quast_return_2"), SubResource("p8_node_o_of_quast_return_2_yes"), SubResource("p8_node_t_of_quast_return_2"), SubResource("p8_node_p8_graves"), SubResource("p8_node_story_3_meet"), SubResource("p8_node_story_3_heart"), SubResource("p8_node_story_1_turn_in")])
