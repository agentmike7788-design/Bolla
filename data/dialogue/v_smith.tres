next = &"menu"

[sub_resource type="Resource" id="p8_node_favor"]
script = ExtResource("1")
id = &"favor"
text = "Was brauchst du? Sag's. Ich frag nicht, wofür."
choices = Array[ExtResource("2")]([SubResource("p8_favor_c01"), SubResource("p8_favor_c02"), SubResource("p8_favor_c03"), SubResource("p8_favor_c04")])

[sub_resource type="Resource" id="p8_favor_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor_done"]
script = ExtResource("1")
id = &"favor_done"
text = "Morgen liegt es bereit. Sag keinem, dass es umsonst war."
choices = Array[ExtResource("2")]([SubResource("p8_favor_done_c01")])

