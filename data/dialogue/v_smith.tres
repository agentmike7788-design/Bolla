[sub_resource type="Resource" id="p8_node_story_2_turn_in"]
script = ExtResource("1")
id = &"story_2_turn_in"
text = "Gutes Eisen. Morgen steht das Gitter. Das erste kostet dich nichts."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_turn_in_c01")])

[sub_resource type="Resource" id="v_smith_c001"]
script = ExtResource("2")
