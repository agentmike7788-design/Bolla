id = &"menu"
text = "Sag."
choices = Array[ExtResource("2")]([SubResource("v_smith_c007"), SubResource("v_smith_c008"), SubResource("v_smith_c009"), SubResource("v_smith_c010"), SubResource("v_smith_c011"), SubResource("v_smith_c012"), SubResource("v_smith_c013"), SubResource("p8_menu_menu_01"), SubResource("p8_menu_menu_02"), SubResource("p8_menu_menu_03"), SubResource("p8_menu_menu_04"), SubResource("p8_menu_menu_05"), SubResource("p8_menu_menu_06"), SubResource("p8_menu_menu_07"), SubResource("p8_menu_menu_08"), SubResource("p8_menu_menu_09"), SubResource("p8_menu_menu_10"), SubResource("p8_menu_menu_11"), SubResource("p8_menu_menu_12"), SubResource("p8_menu_menu_13"), SubResource("p8_menu_menu_14"), SubResource("p8_menu_menu_15"), SubResource("p8_menu_menu_16"), SubResource("v_smith_c014"), SubResource("v_smith_c015")])

[sub_resource type="Resource" id="v_smith_c016"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_esch_charcoal_yes"
actions = Array[String](["order_accept:o_esch_charcoal"])

[sub_resource type="Resource" id="v_smith_c017"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_o_o_esch_charcoal"]
script = ExtResource("1")
id = &"o_o_esch_charcoal"
text = "Holzkohle. Sechs Säcke. Die Esse frisst mehr, als ich kaufen will. Fünf Tage."
choices = Array[ExtResource("2")]([SubResource("v_smith_c016"), SubResource("v_smith_c017")])

[sub_resource type="Resource" id="v_smith_c018"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_o_o_esch_charcoal_yes"]
script = ExtResource("1")
id = &"o_o_esch_charcoal_yes"
text = "Gut."
choices = Array[ExtResource("2")]([SubResource("v_smith_c018")])

[sub_resource type="Resource" id="v_smith_c019"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_esch_stone_yes"
actions = Array[String](["order_accept:o_esch_stone"])

[sub_resource type="Resource" id="v_smith_c020"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_o_o_esch_stone"]
script = ExtResource("1")
id = &"o_o_esch_stone"
text = "Wendel Gratz. Mein Meister. Liegt bei dir oben. Sein Stein ist nicht mehr zu lesen. Ein Bogenstein. Mit einer Fackel. Er hat nie aufgehört zu arbeiten. Sechs Tage."
choices = Array[ExtResource("2")]([SubResource("v_smith_c019"), SubResource("v_smith_c020")])

[sub_resource type="Resource" id="v_smith_c021"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_o_o_esch_stone_yes"]
script = ExtResource("1")
id = &"o_o_esch_stone_yes"
text = "Ich zahl, was es kostet. Mach ihn gerade."
choices = Array[ExtResource("2")]([SubResource("v_smith_c021")])

[sub_resource type="Resource" id="v_smith_c022"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_t_o_esch_charcoal"]
script = ExtResource("1")
id = &"t_o_esch_charcoal"
text = "Gute Kohle. Brennt gleichmäßig."
choices = Array[ExtResource("2")]([SubResource("v_smith_c022")])

[sub_resource type="Resource" id="v_smith_c023"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_t_o_fenner_well"]
script = ExtResource("1")
id = &"t_o_fenner_well"
text = "Sauber gehauen. Fenner kriegt seinen Brunnen. Sag ihm, er soll nicht zählen kommen."
choices = Array[ExtResource("2")]([SubResource("v_smith_c023")])

[sub_resource type="Resource" id="v_smith_c024"]
script = ExtResource("2")
text = "Ich mach ihm einen guten Stein."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_gratz"]
script = ExtResource("1")
id = &"gratz"
text = "Gratz hat mir das Feuer gezeigt. Und den Hammer. Und wann man aufhört. Hat er selbst nie gekonnt."
choices = Array[ExtResource("2")]([SubResource("v_smith_c024")])

[sub_resource type="Resource" id="v_smith_c025"]
script = ExtResource("2")
text = "Warum nicht?"
next = &"about_quast_more"

[sub_resource type="Resource" id="v_smith_c026"]
script = ExtResource("2")
text = "Verstehe."
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_about_quast"]
script = ExtResource("1")
id = &"about_quast"
text = "Quast. Lässt sich Messer machen. Kleine. Sehr scharf. Zahlt gut. Fragt nicht nach dem Preis. Mag ich nicht."
choices = Array[ExtResource("2")]([SubResource("v_smith_c025"), SubResource("v_smith_c026")])

[sub_resource type="Resource" id="v_smith_c027"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_about_quast_more"]
script = ExtResource("1")
id = &"about_quast_more"
text = "Wer nicht nach dem Preis fragt, weiß schon, was es ihm wert ist."
choices = Array[ExtResource("2")]([SubResource("v_smith_c027")])

[sub_resource type="Resource" id="v_smith_c028"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_smith_node_bye"]
script = ExtResource("1")
id = &"bye"
text = "Komm wieder. Das Eisen wartet."
choices = Array[ExtResource("2")]([SubResource("v_smith_c028")])
conditions = Array[String](["rel_tier:smith:friend"])
fallback_next = &"bye_plain"

[sub_resource type="Resource" id="v_smith_c029"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_smith_node_bye_plain"]
script = ExtResource("1")
id = &"bye_plain"
text = "Geh."
choices = Array[ExtResource("2")]([SubResource("v_smith_c029")])

