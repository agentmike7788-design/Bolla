next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_meet"]
script = ExtResource("1")
id = &"story_3_meet"
text = "Setz dich. … Meine Frau ist im Kindbett gestorben. Das Kind auch. Quast war dabei. Er hat getan, was er konnte. Das sag ich jedem."
