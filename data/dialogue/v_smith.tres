[sub_resource type="Resource" id="v_smith_c002"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_smith_node_greet_disreputable"]
script = ExtResource("1")
id = &"greet_disreputable"
text = "Du. Die Leute reden. Ich red nicht. Was willst du?"
