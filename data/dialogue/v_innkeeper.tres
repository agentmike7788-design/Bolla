next = &"story_1"
conditions = Array[String](["step_offerable:innkeeper", "!step_gte:innkeeper:1"])

[sub_resource type="Resource" id="p8_menu_menu_02"]
script = ExtResource("2")
text = "Über Jakobs ersten Tag"
next = &"story_1_done"
conditions = Array[String](["flag:friend_innkeeper_1", "!flag:p8_told_innkeeper_1"])
