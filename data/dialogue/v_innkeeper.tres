next = &"story_2"
conditions = Array[String](["step_offerable:innkeeper", "step_gte:innkeeper:1", "!step_gte:innkeeper:2"])

[sub_resource type="Resource" id="p8_menu_menu_04"]
script = ExtResource("2")
text = "Über Konrads Tafel"
next = &"story_2_done"
conditions = Array[String](["flag:friend_innkeeper_2", "!flag:p8_told_innkeeper_2"])
actions = Array[String](["set_flag:p8_told_innkeeper_2"])

[sub_resource type="Resource" id="p8_menu_menu_05"]
script = ExtResource("2")
text = "[Geschichte] Oben bei Jakob"
next = &"story_3"
conditions = Array[String](["step_offerable:innkeeper", "step_gte:innkeeper:2", "!step_gte:innkeeper:3"])

[sub_resource type="Resource" id="p8_menu_menu_06"]
script = ExtResource("2")
text = "Über den Besuch oben"
next = &"story_3_done"
conditions = Array[String](["flag:friend_innkeeper_3", "!flag:p8_told_innkeeper_3"])
actions = Array[String](["set_flag:p8_told_innkeeper_3"])

[sub_resource type="Resource" id="p8_menu_menu_07"]
script = ExtResource("2")
text = "[Geschichte] …"
next = &"story_cross"
conditions = Array[String](["p8_open", "mood:innkeeper:cross", "!step_gte:innkeeper:3"])

[sub_resource type="Resource" id="p8_menu_menu_08"]
script = ExtResource("2")
text = "[Zuhören]"
next = &"listen"
conditions = Array[String](["p8_open", "mood:innkeeper:low", "!flag_today:p8_listen_innkeeper"])
actions = Array[String](["listen:innkeeper", "set_flag_day:p8_listen_innkeeper"])

[sub_resource type="Resource" id="p8_menu_menu_09"]
script = ExtResource("2")
text = "[Gefallen] Ein Wort im Krug"
next = &"favor"
conditions = Array[String](["step_gte:innkeeper:3", "favor_ready:innkeeper"])

[sub_resource type="Resource" id="p8_menu_menu_10"]
script = ExtResource("2")
