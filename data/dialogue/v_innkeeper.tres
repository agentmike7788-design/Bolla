next = &"o_of_rosine_return_1"
conditions = Array[String](["order_offerable:of_rosine_return_1"])

[sub_resource type="Resource" id="p8_menu_menu_11"]
script = ExtResource("2")
text = "[Gegengefallen] Hier ist es: Holunder für Rosine"
next = &"t_of_rosine_return_1"
conditions = Array[String](["order_ready:of_rosine_return_1"])
actions = Array[String](["order_turn_in:of_rosine_return_1"])

[sub_resource type="Resource" id="p8_menu_menu_12"]
script = ExtResource("2")
text = "[Gegengefallen] Ein Tag für Jakob"
next = &"o_of_rosine_return_2"
conditions = Array[String](["order_offerable:of_rosine_return_2"])

[sub_resource type="Resource" id="p8_menu_menu_13"]
script = ExtResource("2")
text = "[Gegengefallen] Hier ist es: Ein Tag für Jakob"
next = &"t_of_rosine_return_2"
conditions = Array[String](["order_ready:of_rosine_return_2"])
actions = Array[String](["order_turn_in:of_rosine_return_2"])

[sub_resource type="Resource" id="p8_menu_menu_14"]
script = ExtResource("2")
text = "[Tanzen] Einen Tanz? (15 Min)"
next = &"dance"
conditions = Array[String](["fest_running:kathrein"])
actions = Array[String](["dance:innkeeper"])

[sub_resource type="Resource" id="p8_menu_menu_15"]
script = ExtResource("2")
text = "Wie macht sich Jakob?"
next = &"p8_jakob"
conditions = Array[String](["apprentice_hired"])

[sub_resource type="Resource" id="p8_menu_menu_16"]
script = ExtResource("2")
text = "[Geschichte] Du bist heraufgekommen."
next = &"story_3_meet"
conditions = Array[String](["order:of_rosine_3:accepted", "region:graveyard"])
actions = Array[String](["meet:apprentice_lunch"])

[sub_resource type="Resource" id="p8_p8_hill_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_hill"]
script = ExtResource("1")
id = &"p8_hill"
text = "Hier oben ist es stiller, als ich dachte. Gar kein Krug, nirgends. Wie hältst du das aus, Totengräber?"
choices = Array[ExtResource("2")]([SubResource("p8_p8_hill_c01")])
conditions = Array[String](["p8_open", "region:graveyard"])
fallback_next = &"start"
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="p8_story_1_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_1_yes"
actions = Array[String](["step_accept:innkeeper", "apprentice_hire"])

[sub_resource type="Resource" id="p8_story_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1"]
script = ExtResource("1")
id = &"story_1"
text = "Du hast Augen wie einer, der nicht viel schläft. Gut. Mein Jakob schläft zu viel. Seit der Tinktur ist er nicht mehr zu halten, Totengräber, er klettert aufs Dach und redet mit den Hühnern. Nimm ihn mit hinauf. Er soll lernen, was die Leute brauchen, auch wenn sie es nicht wollen. Und etwas, das nicht nach Bier riecht."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_c01"), SubResource("p8_story_1_c02")])

[sub_resource type="Resource" id="p8_story_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_yes"]
script = ExtResource("1")
id = &"story_1_yes"
text = "Morgen früh steht er am Tor, mit Brot in der Tasche. Einen Rechen in seiner Größe hat Esch, eine Gießkanne auch. Schreib ihm an die Tafel, was er tun soll. Lesen kann er. Zuhören weniger."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_yes_c01")])

[sub_resource type="Resource" id="p8_story_1_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_done"]
script = ExtResource("1")
id = &"story_1_done"
text = "Er ist heimgekommen und hat gegessen wie zwei. Dann hat er gesagt: Mutter, oben ist es ruhiger als hier. Ich hab nicht gefragt, ob das gut ist. Ich hab ihm noch Brot gegeben."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_done_c01")])

[sub_resource type="Resource" id="p8_story_2_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_2_yes"
actions = Array[String](["step_accept:innkeeper"])

[sub_resource type="Resource" id="p8_story_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2"]
script = ExtResource("1")
id = &"story_2"
text = "Konrad. Mein Mann. Im Fährwinter ist er hinaus, wie die anderen, und das Wasser hat ihn behalten. Sechzehn haben sie wiedergefunden. Ihn nicht. Er hat kein Grab, Totengräber. Jakob war vier. Mach ihm eine Tafel mit seinem Namen, und bring sie dem Pfarrer. Dann hängt er wenigstens irgendwo."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_c01"), SubResource("p8_story_2_c02")])

[sub_resource type="Resource" id="p8_story_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_yes"]
script = ExtResource("1")
id = &"story_2_yes"
text = "Konrad Wackernagel. Mit zwei a. Die Leute schreiben ihn immer falsch, als hätten sie ihn nie gekannt."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_yes_c01")])

[sub_resource type="Resource" id="p8_story_2_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_done"]
script = ExtResource("1")
id = &"story_2_done"
text = "Ich war in der Kirche. Sie hängt am Gedenkbrett, gleich unter der Fähre. Ich hab sie angefasst. Sie war kalt. Er war auch immer kalt an den Händen. Danke, Totengräber. Das sag ich nicht zweimal."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_done_c01")])

[sub_resource type="Resource" id="p8_story_3_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_3_yes"
actions = Array[String](["step_accept:innkeeper"])

[sub_resource type="Resource" id="p8_story_3_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3"]
script = ExtResource("1")
id = &"story_3"
text = "Ich will ihn einmal sehen, oben bei dir. Bei der Arbeit, nicht beim Essen. Um drei, an der Bank bei deiner Hütte. Wenn er's kann. Wenn nicht, sag's mir vorher, dann komm ich nicht."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_c01"), SubResource("p8_story_3_c02")])

[sub_resource type="Resource" id="p8_story_3_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_yes"]
script = ExtResource("1")
id = &"story_3_yes"
text = "Um drei. Ich bring Kuchen mit. Nicht für ihn. Für dich."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_yes_c01")])

[sub_resource type="Resource" id="p8_story_3_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_done"]
script = ExtResource("1")
id = &"story_3_done"
text = "Er hält den Rechen wie du. Das hat er nicht von mir. Ich hab den ganzen Weg hinunter nichts gesagt, und Wackernagel sagt immer was. Das bleibt unter uns."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_done_c01")])

[sub_resource type="Resource" id="p8_story_cross_c01"]
script = ExtResource("2")
text = "Morgen also."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_cross"]
script = ExtResource("1")
id = &"story_cross"
text = "Heute nicht, Totengräber. Morgen."
choices = Array[ExtResource("2")]([SubResource("p8_story_cross_c01")])

[sub_resource type="Resource" id="p8_listen_c01"]
script = ExtResource("2")
text = "(Schweigen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_listen"]
script = ExtResource("1")
id = &"listen"
text = "Konrad hätte heute Namenstag gehabt. Ich weiß nicht, warum ich dir das sag. Ich stell ihm jedes Jahr ein Glas hin. Keiner trinkt es. Abends kipp ich es weg. … So. Jetzt ist es gesagt."
choices = Array[ExtResource("2")]([SubResource("p8_listen_c01")])

[sub_resource type="Resource" id="p8_favor_c01"]
script = ExtResource("2")
text = "Ja, bitte."
next = &"favor_done"
actions = Array[String](["favor_use:innkeeper"])

[sub_resource type="Resource" id="p8_favor_c02"]
script = ExtResource("2")
text = "Ein andermal."
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor"]
script = ExtResource("1")
id = &"favor"
text = "Du willst, dass Wackernagel den Mund aufmacht? Für dich? Wenn die nächsten Tage einer was Schlechtes über dich sagt, red ich es klein. Das kann ich. Das ist mein Beruf."
choices = Array[ExtResource("2")]([SubResource("p8_favor_c01"), SubResource("p8_favor_c02")])

[sub_resource type="Resource" id="p8_favor_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor_done"]
script = ExtResource("1")
id = &"favor_done"
text = "Abgemacht. Wenn einer über dich redet, red ich lauter. Das kann Wackernagel."
choices = Array[ExtResource("2")]([SubResource("p8_favor_done_c01")])

[sub_resource type="Resource" id="p8_o_of_rosine_return_1_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_rosine_return_1_yes"
actions = Array[String](["order_accept:of_rosine_return_1"])

[sub_resource type="Resource" id="p8_o_of_rosine_return_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_rosine_return_1"]
script = ExtResource("1")
id = &"o_of_rosine_return_1"
text = "Sechs Hände Holunderbeeren, wenn du welche findest. Der Wein wartet nicht."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_rosine_return_1_c01"), SubResource("p8_o_of_rosine_return_1_c02")])

[sub_resource type="Resource" id="p8_o_of_rosine_return_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_rosine_return_1_yes"]
script = ExtResource("1")
id = &"o_of_rosine_return_1_yes"
text = "Drei Tage. Dann sind sie mir zu weich."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_rosine_return_1_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_rosine_return_1_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_rosine_return_1"]
script = ExtResource("1")
id = &"t_of_rosine_return_1"
text = "Holunder. Sechs Hände. Du hast es nicht vergessen."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_rosine_return_1_c01")])

[sub_resource type="Resource" id="p8_o_of_rosine_return_2_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_rosine_return_2_yes"
actions = Array[String](["order_accept:of_rosine_return_2"])

[sub_resource type="Resource" id="p8_o_of_rosine_return_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_rosine_return_2"]
script = ExtResource("1")
id = &"o_of_rosine_return_2"
text = "Gib dem Jungen einen Tag frei. Den Lohn trotzdem. Er schläft wieder zu wenig, seit er bei dir ist. Das ist auch nicht recht."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_rosine_return_2_c01"), SubResource("p8_o_of_rosine_return_2_c02")])

[sub_resource type="Resource" id="p8_o_of_rosine_return_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_rosine_return_2_yes"]
script = ExtResource("1")
id = &"o_of_rosine_return_2_yes"
text = "Einen Tag. Er wird maulen. Lass ihn."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_rosine_return_2_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_rosine_return_2_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_rosine_return_2"]
script = ExtResource("1")
id = &"t_of_rosine_return_2"
text = "Er hat bis Mittag geschlafen. Dann hat er gefragt, ob oben alles in Ordnung ist. Ich hab gesagt: Frag ihn selber."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_rosine_return_2_c01")])

[sub_resource type="Resource" id="p8_dance_c01"]
script = ExtResource("2")
text = "(Zurück an den Tisch)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_dance"]
script = ExtResource("1")
id = &"dance"
text = "Kathrein stellt den Tanz ein, aber noch nicht jetzt. Komm, Totengräber. Du trittst wie einer, der Erde gewohnt ist. Das macht nichts. Ich führe."
choices = Array[ExtResource("2")]([SubResource("p8_dance_c01")])

[sub_resource type="Resource" id="p8_p8_jakob_c01"]
script = ExtResource("2")
text = "Ich weiß."
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_jakob"]
script = ExtResource("1")
id = &"p8_jakob"
text = "Er redet nur noch vom Hügel. Vom Laub, das von unten nach oben geharkt wird, nicht hin und her. Von dir. Wenn du streng bist, sag ich nichts. Wenn du zu streng bist, sag ich was. Laut."
choices = Array[ExtResource("2")]([SubResource("p8_p8_jakob_c01")])

[sub_resource type="Resource" id="p8_story_3_meet_c01"]
script = ExtResource("2")
text = "(Sich neben sie setzen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_meet"]
script = ExtResource("1")
id = &"story_3_meet"
text = "Er hält den Rechen wie du. Das hat er nicht von mir. Schau, wie er pfeift. Das hat er von Konrad. Ich bleib noch ein bisschen. Er soll nicht merken, dass ich schau."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_meet_c01")])

[sub_resource type="Resource" id="v_innkeeper_c001"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_start"]
script = ExtResource("1")
id = &"start"
text = "Na endlich! Der vom Hügel. Wackernagel, Rosine, mir gehört der Holderkrug, und was im Dorf geredet wird, hör ich zuerst. Setz dich, Totengräber. Faulhaber hat gesagt, du trinkst kein Wasser, wenn es Bier gibt. Stimmt das?"
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c001")])
conditions = Array[String](["!met:innkeeper"])
fallback_next = &"greet_disreputable"
actions = Array[String](["meet:innkeeper", "talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c002"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_greet_disreputable"]
script = ExtResource("1")
id = &"greet_disreputable"
text = "Du bist der vom Hügel. Setz dich ans Fenster, da sieht dich keiner. Und Finger weg vom Zinn, Totengräber, das zähl ich abends."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c002")])
conditions = Array[String](["rep_tier:disreputable"])
fallback_next = &"greet_unremarkable"
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c003"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_greet_unremarkable"]
script = ExtResource("1")
id = &"greet_unremarkable"
text = "Ah, der Totengräber. Hast du Durst oder Neuigkeiten? Bei mir geht beides, das eine kostet."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c003")])
conditions = Array[String](["rep_tier:unremarkable"])
fallback_next = &"greet_respected"
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c004"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_greet_respected"]
script = ExtResource("1")
id = &"greet_respected"
text = "Totengräber! Komm rein, es zieht. Kehr sitzt am Ofen, Brandt beim Fenster, und für dich ist auch noch was frei."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c004")])
conditions = Array[String](["rep_tier:respected"])
fallback_next = &"greet_esteemed"
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c005"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_greet_esteemed"]
script = ExtResource("1")
id = &"greet_esteemed"
text = "Da ist er ja! Fenner hat gestern gesagt, oben sieht es aus wie beim Herrgott im Vorgarten. Ich hab gesagt: Das liegt am Totengräber, nicht am Herrgott."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c005")])
conditions = Array[String](["rep_tier:esteemed"])
fallback_next = &"greet_renowned"
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c006"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_greet_renowned"]
script = ExtResource("1")
id = &"greet_renowned"
text = "Wackernagel hat für dich einen Stuhl am Ofen frei. Den kriegt sonst nur der Pfarrer. Und der zahlt seltener."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c006")])
actions = Array[String](["talked:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c007"]
script = ExtResource("2")
text = "Was hast du da?"
conditions = Array[String](["shop_open:inn"])
actions = Array[String](["open_shop:inn"])

[sub_resource type="Resource" id="v_innkeeper_c008"]
script = ExtResource("2")
text = "Eine Runde für alle! (5 Münzen)"
next = &"round"
conditions = Array[String](["village_can:round"])
actions = Array[String](["buy_round"])

[sub_resource type="Resource" id="v_innkeeper_c009"]
script = ExtResource("2")
text = "[Auftrag] Holunder für den Wein"
next = &"o_o_rosine_berries"
conditions = Array[String](["order_offerable:o_rosine_berries"])

[sub_resource type="Resource" id="v_innkeeper_c010"]
script = ExtResource("2")
text = "[Auftrag] Fieber im Haus"
next = &"o_o_rosine_tincture"
conditions = Array[String](["order_offerable:o_rosine_tincture"])

[sub_resource type="Resource" id="v_innkeeper_c011"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Holunderbeeren"
next = &"t_o_rosine_berries"
conditions = Array[String](["order_ready:o_rosine_berries"])
actions = Array[String](["order_turn_in:o_rosine_berries"])

[sub_resource type="Resource" id="v_innkeeper_c012"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Fiebertinktur"
next = &"t_o_rosine_tincture"
conditions = Array[String](["order_ready:o_rosine_tincture"])
actions = Array[String](["order_turn_in:o_rosine_tincture"])

[sub_resource type="Resource" id="v_innkeeper_c013"]
script = ExtResource("2")
text = "Was redet man im Dorf?"
next = &"gossip"

[sub_resource type="Resource" id="v_innkeeper_c014"]
script = ExtResource("2")
text = "Kennst du die alte Hagedorn?"
next = &"about_wiebke"
conditions = Array[String](["alive:oldwoman"])

[sub_resource type="Resource" id="v_innkeeper_c015"]
script = ExtResource("2")
text = "Was ist mit Wiebke Hagedorn?"
next = &"about_wiebke_dead"
conditions = Array[String](["!alive:oldwoman"])

[sub_resource type="Resource" id="v_innkeeper_c016"]
script = ExtResource("2")
text = "Ich hab dir etwas mitgebracht."
actions = Array[String](["open_gifts:innkeeper"])

[sub_resource type="Resource" id="v_innkeeper_c017"]
script = ExtResource("2")
text = "Auf Wiedersehen."
next = &"bye"

[sub_resource type="Resource" id="v_innkeeper_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "Also, was darf's sein? Wackernagel hat nur zwei Ohren, aber die sind beide offen."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c007"), SubResource("v_innkeeper_c008"), SubResource("v_innkeeper_c009"), SubResource("v_innkeeper_c010"), SubResource("v_innkeeper_c011"), SubResource("v_innkeeper_c012"), SubResource("v_innkeeper_c013"), SubResource("v_innkeeper_c014"), SubResource("v_innkeeper_c015"), SubResource("p8_menu_menu_01"), SubResource("p8_menu_menu_02"), SubResource("p8_menu_menu_03"), SubResource("p8_menu_menu_04"), SubResource("p8_menu_menu_05"), SubResource("p8_menu_menu_06"), SubResource("p8_menu_menu_07"), SubResource("p8_menu_menu_08"), SubResource("p8_menu_menu_09"), SubResource("p8_menu_menu_10"), SubResource("p8_menu_menu_11"), SubResource("p8_menu_menu_12"), SubResource("p8_menu_menu_13"), SubResource("p8_menu_menu_14"), SubResource("p8_menu_menu_15"), SubResource("p8_menu_menu_16"), SubResource("v_innkeeper_c016"), SubResource("v_innkeeper_c017")])

[sub_resource type="Resource" id="v_innkeeper_c018"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_rosine_berries_yes"
actions = Array[String](["order_accept:o_rosine_berries"])

[sub_resource type="Resource" id="v_innkeeper_c019"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_o_o_rosine_berries"]
script = ExtResource("1")
id = &"o_o_rosine_berries"
text = "Acht Hände voll Holunderbeeren, Totengräber! Der Holunderwein setzt sich nicht von allein an, und Wackernagel hat nur zwei Hände und einen Wirt, der lieber Karten spielt. Fünf Tage geb ich dir."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c018"), SubResource("v_innkeeper_c019")])

[sub_resource type="Resource" id="v_innkeeper_c020"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_o_o_rosine_berries_yes"]
script = ExtResource("1")
id = &"o_o_rosine_berries_yes"
text = "Abgemacht! Wenn du sie bringst, kriegst du das erste Glas. Das zweite trinken wir zusammen, das dritte zahlst du."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c020")])

[sub_resource type="Resource" id="v_innkeeper_c021"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_rosine_tincture_yes"
actions = Array[String](["order_accept:o_rosine_tincture"])

[sub_resource type="Resource" id="v_innkeeper_c022"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_o_o_rosine_tincture"]
script = ExtResource("1")
id = &"o_o_rosine_tincture"
text = "Jakob fiebert. Mein Jüngster. Seit drei Nächten. Und der Quast nimmt zu viel, für ein Fläschchen will der eine halbe Ziege. Zwei Fläschchen Fiebertinktur, Totengräber. Oder diese Bittertropfen, ich nehm, was hilft."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c021"), SubResource("v_innkeeper_c022")])

[sub_resource type="Resource" id="v_innkeeper_c023"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_o_o_rosine_tincture_yes"]
script = ExtResource("1")
id = &"o_o_rosine_tincture_yes"
text = "Gott vergelt's. Und wenn nicht der, dann Wackernagel. Vier Tage, länger hält der Junge das nicht aus. Ich auch nicht."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c023")])

[sub_resource type="Resource" id="v_innkeeper_c024"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_t_o_rosine_berries"]
script = ExtResource("1")
id = &"t_o_rosine_berries"
text = "Acht Hände voll! Siehst du, Kehr, ich hab's gesagt, der hält Wort. Kehr hat nichts gesagt. Kehr sagt nie was."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c024")])

[sub_resource type="Resource" id="v_innkeeper_c025"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_t_o_rosine_tincture"]
script = ExtResource("1")
id = &"t_o_rosine_tincture"
text = "Ich bring sie gleich hoch. Wackernagel weint nicht, Totengräber, das ist der Rauch vom Ofen."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c025")])

[sub_resource type="Resource" id="v_innkeeper_c026"]
script = ExtResource("2")
text = "Prost."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_round"]
script = ExtResource("1")
id = &"round"
text = "Eine Runde für alle! Habt ihr gehört? Der Totengräber zahlt! Esch, mach den Mund zu und das Glas auf. Wackernagel schenkt aus, und für eine Viertelstunde redet keiner über die Toten."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c026")])

[sub_resource type="Resource" id="v_innkeeper_c027"]
script = ExtResource("2")
text = "Und über mich?"
next = &"gossip_me"

[sub_resource type="Resource" id="v_innkeeper_c028"]
script = ExtResource("2")
text = "Danke, Rosine."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_gossip"]
script = ExtResource("1")
id = &"gossip"
text = "Was man redet? Dass Kehr seiner Frau die Hühner verkauft hat, ohne zu fragen. Dass Fenner Wasser in den Beinen hat und es keinem sagt, und das sag ich dir jetzt auch nicht. Und dass bei Quast nachts Licht brennt, aber das redet man, seit er da ist."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c027"), SubResource("v_innkeeper_c028")])

[sub_resource type="Resource" id="v_innkeeper_c029"]
script = ExtResource("2")
text = "Gut zu wissen."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_gossip_me"]
script = ExtResource("1")
id = &"gossip_me"
text = "Über dich? Dass du mit den Toten redest. Ich hab gesagt: Na und, Mangold redet mit ihren Kartoffeln, und die antworten noch seltener."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c029")])

[sub_resource type="Resource" id="v_innkeeper_c030"]
script = ExtResource("2")
text = "Ich red mal mit ihr."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_about_wiebke"]
script = ExtResource("1")
id = &"about_wiebke"
text = "Die Hagedorn? Einundachtzig und frecher als meine Kinder. Sitzt jeden Morgen am Brunnen und erzählt jedem, wo sie mal liegen will. Oben bei dir, mit Blick auf die Linde. Sie hat schon ihren Mohn getrocknet, sagt sie. Der Pfarrer geht jeden Tag zu ihr. Quast auch, wenn es zieht. Die sterben ja nicht, die Alten, die werden nur besucht."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c030")])

[sub_resource type="Resource" id="v_innkeeper_c031"]
script = ExtResource("2")
text = "Das tue ich."
next = &"menu"

[sub_resource type="Resource" id="v_innkeeper_node_about_wiebke_dead"]
script = ExtResource("1")
id = &"about_wiebke_dead"
text = "Ach, die Hagedorn. Liesel hat sie gewaschen. Wackernagel hat drei Tage nicht gelacht, das ist Rekord. Leg sie ordentlich hin da oben, Totengräber. Mit dem Mohn."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c031")])

[sub_resource type="Resource" id="v_innkeeper_c032"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_innkeeper_node_bye"]
script = ExtResource("1")
id = &"bye"
text = "Pass auf dich auf, Totengräber. Wackernagel hat nicht so viele, um die sie sich sorgen kann. Eigentlich doch. Aber du zählst mit."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c032")])
conditions = Array[String](["rel_tier:innkeeper:friend"])
fallback_next = &"bye_plain"

[sub_resource type="Resource" id="v_innkeeper_c033"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_innkeeper_node_bye_plain"]
script = ExtResource("1")
id = &"bye_plain"
text = "Komm gut den Hügel rauf. Und grüß die Toten von Wackernagel, die waren alle mal Gäste."
choices = Array[ExtResource("2")]([SubResource("v_innkeeper_c033")])

[resource]
script = ExtResource("3")
id = &"v_innkeeper"
speaker_name = "Rosine Wackernagel"
start_node = &"p8_hill"
nodes = Array[ExtResource("1")]([SubResource("v_innkeeper_node_start"), SubResource("v_innkeeper_node_greet_disreputable"), SubResource("v_innkeeper_node_greet_unremarkable"), SubResource("v_innkeeper_node_greet_respected"), SubResource("v_innkeeper_node_greet_esteemed"), SubResource("v_innkeeper_node_greet_renowned"), SubResource("v_innkeeper_node_menu"), SubResource("v_innkeeper_node_o_o_rosine_berries"), SubResource("v_innkeeper_node_o_o_rosine_berries_yes"), SubResource("v_innkeeper_node_o_o_rosine_tincture"), SubResource("v_innkeeper_node_o_o_rosine_tincture_yes"), SubResource("v_innkeeper_node_t_o_rosine_berries"), SubResource("v_innkeeper_node_t_o_rosine_tincture"), SubResource("v_innkeeper_node_round"), SubResource("v_innkeeper_node_gossip"), SubResource("v_innkeeper_node_gossip_me"), SubResource("v_innkeeper_node_about_wiebke"), SubResource("v_innkeeper_node_about_wiebke_dead"), SubResource("v_innkeeper_node_bye"), SubResource("v_innkeeper_node_bye_plain"), SubResource("p8_node_p8_hill"), SubResource("p8_node_story_1"), SubResource("p8_node_story_1_yes"), SubResource("p8_node_story_1_done"), SubResource("p8_node_story_2"), SubResource("p8_node_story_2_yes"), SubResource("p8_node_story_2_done"), SubResource("p8_node_story_3"), SubResource("p8_node_story_3_yes"), SubResource("p8_node_story_3_done"), SubResource("p8_node_story_cross"), SubResource("p8_node_listen"), SubResource("p8_node_favor"), SubResource("p8_node_favor_done"), SubResource("p8_node_o_of_rosine_return_1"), SubResource("p8_node_o_of_rosine_return_1_yes"), SubResource("p8_node_t_of_rosine_return_1"), SubResource("p8_node_o_of_rosine_return_2"), SubResource("p8_node_o_of_rosine_return_2_yes"), SubResource("p8_node_t_of_rosine_return_2"), SubResource("p8_node_dance"), SubResource("p8_node_p8_jakob"), SubResource("p8_node_story_3_meet")])
