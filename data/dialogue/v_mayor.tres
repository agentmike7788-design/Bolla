[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_data.gd" id="3"]

[sub_resource type="Resource" id="p8_menu_menu_01"]
script = ExtResource("2")
text = "[Geschichte] Die Beine"
next = &"story_1"
conditions = Array[String](["step_offerable:mayor", "!step_gte:mayor:1"])

[sub_resource type="Resource" id="p8_menu_menu_02"]
script = ExtResource("2")
text = "Über die Beine"
next = &"story_1_done"
conditions = Array[String](["flag:friend_mayor_1", "!flag:p8_told_mayor_1"])
