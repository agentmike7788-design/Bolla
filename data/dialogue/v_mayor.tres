[sub_resource type="Resource" id="p8_menu_menu_03"]
script = ExtResource("2")
text = "[Geschichte] Ein Platz mit Blick"
next = &"story_2"
conditions = Array[String](["step_offerable:mayor", "step_gte:mayor:1", "!step_gte:mayor:2"])

[sub_resource type="Resource" id="p8_menu_menu_04"]
script = ExtResource("2")
text = "Über den Platz mit Blick"
next = &"story_2_done"
conditions = Array[String](["flag:friend_mayor_2", "!flag:p8_told_mayor_2"])
actions = Array[String](["set_flag:p8_told_mayor_2"])

[sub_resource type="Resource" id="p8_menu_menu_05"]
script = ExtResource("2")
text = "[Geschichte] Eine Runde von mir"
next = &"story_3"
conditions = Array[String](["step_offerable:mayor", "step_gte:mayor:2", "!step_gte:mayor:3"])

[sub_resource type="Resource" id="p8_menu_menu_06"]
script = ExtResource("2")
text = "Über die Runde"
next = &"story_3_done"
conditions = Array[String](["flag:friend_mayor_3", "!flag:p8_told_mayor_3"])
actions = Array[String](["set_flag:p8_told_mayor_3"])

[sub_resource type="Resource" id="p8_menu_menu_07"]
script = ExtResource("2")
text = "[Geschichte] …"
next = &"story_cross"
conditions = Array[String](["p8_open", "mood:mayor:cross", "!step_gte:mayor:3"])

[sub_resource type="Resource" id="p8_menu_menu_08"]
script = ExtResource("2")
text = "[Zuhören]"
next = &"listen"
conditions = Array[String](["p8_open", "mood:mayor:low", "!flag_today:p8_listen_mayor"])
actions = Array[String](["listen:mayor", "set_flag_day:p8_listen_mayor"])

[sub_resource type="Resource" id="p8_menu_menu_09"]
script = ExtResource("2")
text = "[Gefallen] Der Nachtwächter"
next = &"favor"
conditions = Array[String](["step_gte:mayor:3", "favor_ready:mayor"])

[sub_resource type="Resource" id="p8_menu_menu_10"]
script = ExtResource("2")
text = "[Gegengefallen] Holz für den Gemeindezaun"
next = &"o_of_fenner_return_1"
conditions = Array[String](["order_offerable:of_fenner_return_1"])

[sub_resource type="Resource" id="p8_menu_menu_11"]
script = ExtResource("2")
text = "[Gegengefallen] Hier ist es: Holz für den Gemeindezaun"
next = &"t_of_fenner_return_1"
conditions = Array[String](["order_ready:of_fenner_return_1"])
actions = Array[String](["order_turn_in:of_fenner_return_1"])

[sub_resource type="Resource" id="p8_menu_menu_12"]
script = ExtResource("2")
text = "[Gegengefallen] Die Armenkasse"
next = &"o_of_fenner_return_2"
conditions = Array[String](["order_offerable:of_fenner_return_2"])

[sub_resource type="Resource" id="p8_menu_menu_13"]
script = ExtResource("2")
text = "[Gegengefallen] Hier ist es: Die Armenkasse"
next = &"t_of_fenner_return_2"
conditions = Array[String](["order_ready:of_fenner_return_2"])
actions = Array[String](["order_turn_in:of_fenner_return_2"])

[sub_resource type="Resource" id="p8_menu_menu_14"]
script = ExtResource("2")
text = "[Tanzen] Einen Tanz? (15 Min)"
next = &"dance"
conditions = Array[String](["fest_running:kathrein"])
actions = Array[String](["dance:mayor"])

[sub_resource type="Resource" id="p8_menu_menu_15"]
script = ExtResource("2")
text = "[Geschichte] Hier, die zwölfte Stelle."
next = &"story_2_meet"
conditions = Array[String](["order:of_fenner_2:accepted", "region:graveyard"])
actions = Array[String](["meet:gv_l_12"])

[sub_resource type="Resource" id="p8_menu_menu_16"]
script = ExtResource("2")
text = "[Geschichte] Ein Bier, Herr Schultheiß?"
next = &"story_3_meet"
conditions = Array[String](["order:of_fenner_3:accepted", "time_between:1085:1260"])
actions = Array[String](["meet:v_in_inn_table"])

[sub_resource type="Resource" id="p8_menu_menu_17"]
script = ExtResource("2")
text = "[Auftrag] Der Umschlag für die Beine."
next = &"story_1_turn_in"
conditions = Array[String](["order_ready:of_fenner_1"])
actions = Array[String](["order_turn_in:of_fenner_1"])

[sub_resource type="Resource" id="p8_p8_row3_c01"]
script = ExtResource("2")
text = "Danke, Herr Schultheiß."
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_row3"]
script = ExtResource("1")
id = &"p8_row3"
text = "Totengräber, die Gemeinde hat getagt. Der Lindenacker ist voll, das haben wir bemerkt. Ich gebe Ihnen die dritte Reihe am Südrand, vier Stellen. Ein Stumpf ist da und eine Brombeere, die müssen weg, aber geweiht ist der ganze Acker, sagt der Pfarrer. Ich habe es aufgeschrieben."
choices = Array[ExtResource("2")]([SubResource("p8_p8_row3_c01")])
conditions = Array[String](["p8_open", "!flag:linden_row3_granted"])
fallback_next = &"p8_robber"
actions = Array[String](["set_flag:linden_row3_granted", "notify:Die Gemeinde gibt dir die dritte Reihe am Lindenacker.", "talked:mayor"])

[sub_resource type="Resource" id="p8_p8_robber_c01"]
script = ExtResource("2")
text = "Gut."
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_robber"]
script = ExtResource("1")
id = &"p8_robber"
text = "Den Grell haben wir. Er ist in der Stadt. Die Gemeinde dankt Ihnen, schriftlich folgt. Ein Grabräuber in Hollerbrück. Das kommt ins Protokoll, mit Ihrem Namen, auf der guten Seite."
choices = Array[ExtResource("2")]([SubResource("p8_p8_robber_c01")])
conditions = Array[String](["robber_fate:reported", "!flag:p8_fenner_robber"])
fallback_next = &"p8_robber_watch"
actions = Array[String](["set_flag:p8_fenner_robber", "talked:mayor"])

[sub_resource type="Resource" id="p8_p8_robber_watch_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_robber_watch"]
script = ExtResource("1")
id = &"p8_robber_watch"
text = "Drei offene Gräber, Totengräber. Drei. Mein Nachtwächter hat ihn gefangen, am Waldrand, mit Sack und Spaten. Er ist in der Stadt. Ich hätte Sie lieber nicht erwähnt."
choices = Array[ExtResource("2")]([SubResource("p8_p8_robber_watch_c01")])
conditions = Array[String](["robber_fate:caught_watch", "!flag:p8_fenner_robber"])
fallback_next = &"p8_robber_let_go"
actions = Array[String](["set_flag:p8_fenner_robber", "talked:mayor"])

[sub_resource type="Resource" id="p8_p8_robber_let_go_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_robber_let_go"]
script = ExtResource("1")
id = &"p8_robber_let_go"
text = "Veit sagt, Sie haben ihn laufen lassen. Den Grell. Ich sage dazu nichts. Amtlich nicht. Persönlich auch nicht. Das ist mehr, als Sie verdienen."
choices = Array[ExtResource("2")]([SubResource("p8_p8_robber_let_go_c01")])
conditions = Array[String](["robber_fate:let_go", "!flag:p8_fenner_robber"])
fallback_next = &"p8_hill"
actions = Array[String](["set_flag:p8_fenner_robber", "talked:mayor"])

[sub_resource type="Resource" id="p8_p8_hill_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_p8_hill"]
script = ExtResource("1")
id = &"p8_hill"
text = "Ah, Totengräber. Ich bin, sagen wir, dienstlich hier. Halb dienstlich. Der Rest ist meine Sache."
choices = Array[ExtResource("2")]([SubResource("p8_p8_hill_c01")])
conditions = Array[String](["region:graveyard"])
fallback_next = &"start"
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="p8_story_1_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_1_yes"
actions = Array[String](["step_accept:mayor"])

[sub_resource type="Resource" id="p8_story_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1"]
script = ExtResource("1")
id = &"story_1"
text = "Unter vier Augen, Totengräber. Die Wassersucht wird schlimmer. Einen Wacholderumschlag, wenn Sie haben. Zwei Hände Wacholder, eine Bahn Leinen. Oder das Pulver, falls Sie noch eins übrig haben. Diskret, bitte. Amtlich diskret."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_c01"), SubResource("p8_story_1_c02")])

[sub_resource type="Resource" id="p8_story_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_yes"]
script = ExtResource("1")
id = &"story_1_yes"
text = "Ich trage es nicht ein. Das ist ein Opfer."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_yes_c01")])

[sub_resource type="Resource" id="p8_story_1_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_done"]
script = ExtResource("1")
id = &"story_1_done"
text = "Die Beine sind besser. Nicht gut, aber besser. Ich habe heute zwei Treppen genommen, ohne zu zählen. Fast ohne."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_done_c01")])

[sub_resource type="Resource" id="p8_story_2_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_2_yes"
actions = Array[String](["step_accept:mayor"])

[sub_resource type="Resource" id="p8_story_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2"]
script = ExtResource("1")
id = &"story_2"
text = "Ich möchte mir einen Platz ansehen. Für später. Sehr viel später, verstehen Sie. In der dritten Reihe, mit Blick aufs Amtshaus, wenn man das von oben sieht. Ich komme um vier hinauf. Statt der Gemeindetafel."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_c01"), SubResource("p8_story_2_c02")])

[sub_resource type="Resource" id="p8_story_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_yes"]
script = ExtResource("1")
id = &"story_2_yes"
text = "Um vier. Ich bringe das Register mit. Man weiß nie."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_yes_c01")])

[sub_resource type="Resource" id="p8_story_2_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_done"]
script = ExtResource("1")
id = &"story_2_done"
text = "Die zwölfte Stelle. Ich habe sie mir vermerkt, nur vermerkt, nicht gesperrt. Und den Schlüssel haben Sie ja nun. Gehen Sie sparsam damit um. Akten verzeihen nichts."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_done_c01")])

[sub_resource type="Resource" id="p8_story_3_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"story_3_yes"
actions = Array[String](["step_accept:mayor"])

[sub_resource type="Resource" id="p8_story_3_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3"]
script = ExtResource("1")
id = &"story_3"
text = "Kommen Sie abends in den Krug. Heute zahle ich. Das kommt selten vor, ich habe es nachgerechnet."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_c01"), SubResource("p8_story_3_c02")])

[sub_resource type="Resource" id="p8_story_3_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_yes"]
script = ExtResource("1")
id = &"story_3_yes"
text = "Ab sechs. Ich sitze am Tisch mit der Kerbe."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_yes_c01")])

[sub_resource type="Resource" id="p8_story_3_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_done"]
script = ExtResource("1")
id = &"story_3_done"
text = "Ich habe Ihnen von meiner Frau erzählt. Das ist nicht amtlich. Das ist überhaupt nichts. Danke, dass Sie es so behandeln."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_done_c01")])

[sub_resource type="Resource" id="p8_story_cross_c01"]
script = ExtResource("2")
text = "Morgen also."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_cross"]
script = ExtResource("1")
id = &"story_cross"
text = "Heute nicht, Totengräber. Morgen. Im Rahmen der Öffnungszeiten."
choices = Array[ExtResource("2")]([SubResource("p8_story_cross_c01")])

[sub_resource type="Resource" id="p8_listen_c01"]
script = ExtResource("2")
text = "(Schweigen)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_listen"]
script = ExtResource("1")
id = &"listen"
text = "Heute habe ich den Gemeindehaushalt dreimal gerechnet, und jedes Mal fehlten vier Münzen. Ich weiß, wo sie sind. Ich habe sie meiner Frau aufs Grab gelegt, unten bei St. Gallus. Jedes Jahr. … Das bleibt unter uns."
choices = Array[ExtResource("2")]([SubResource("p8_listen_c01")])

[sub_resource type="Resource" id="p8_favor_c01"]
script = ExtResource("2")
text = "Heute Nacht."
next = &"favor_done"
actions = Array[String](["favor_use:mayor"])

[sub_resource type="Resource" id="p8_favor_c02"]
script = ExtResource("2")
text = "Ein andermal."
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor"]
script = ExtResource("1")
id = &"favor"
text = "Der Nachtwächter, eine Nacht auf Ihrem Hügel? Das lässt sich einrichten. Sagen Sie mir, welche. Heute? Gut. Ich trage es ein."
choices = Array[ExtResource("2")]([SubResource("p8_favor_c01"), SubResource("p8_favor_c02")])

[sub_resource type="Resource" id="p8_favor_done_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_favor_done"]
script = ExtResource("1")
id = &"favor_done"
text = "Der Nachtwächter geht heute Nacht über den Hügel. Mit Laterne und Horn. Ich trage es ein."
choices = Array[ExtResource("2")]([SubResource("p8_favor_done_c01")])

[sub_resource type="Resource" id="p8_o_of_fenner_return_1_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_fenner_return_1_yes"
actions = Array[String](["order_accept:of_fenner_return_1"])

[sub_resource type="Resource" id="p8_o_of_fenner_return_1_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_fenner_return_1"]
script = ExtResource("1")
id = &"o_of_fenner_return_1"
text = "Zehn Scheit Holz für den Zaun der Gemeinde. Ordnungsgemäß."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_fenner_return_1_c01"), SubResource("p8_o_of_fenner_return_1_c02")])

[sub_resource type="Resource" id="p8_o_of_fenner_return_1_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_fenner_return_1_yes"]
script = ExtResource("1")
id = &"o_of_fenner_return_1_yes"
text = "Vermerkt."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_fenner_return_1_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_fenner_return_1_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_fenner_return_1"]
script = ExtResource("1")
id = &"t_of_fenner_return_1"
text = "Zehn. Ich zähle: zehn. Die Gemeinde dankt."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_fenner_return_1_c01")])

[sub_resource type="Resource" id="p8_o_of_fenner_return_2_c01"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_of_fenner_return_2_yes"
actions = Array[String](["order_accept:of_fenner_return_2"])

[sub_resource type="Resource" id="p8_o_of_fenner_return_2_c02"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_fenner_return_2"]
script = ExtResource("1")
id = &"o_of_fenner_return_2"
text = "Fünf Münzen in die Armenkasse. Für die Ordnung, nicht für mich."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_fenner_return_2_c01"), SubResource("p8_o_of_fenner_return_2_c02")])

[sub_resource type="Resource" id="p8_o_of_fenner_return_2_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="p8_node_o_of_fenner_return_2_yes"]
script = ExtResource("1")
id = &"o_of_fenner_return_2_yes"
text = "Vermerkt."
choices = Array[ExtResource("2")]([SubResource("p8_o_of_fenner_return_2_yes_c01")])

[sub_resource type="Resource" id="p8_t_of_fenner_return_2_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_t_of_fenner_return_2"]
script = ExtResource("1")
id = &"t_of_fenner_return_2"
text = "Fünf Münzen. Eins, zwei, drei, vier, fünf. Mit Ihrem Namen."
choices = Array[ExtResource("2")]([SubResource("p8_t_of_fenner_return_2_c01")])

[sub_resource type="Resource" id="p8_dance_c01"]
script = ExtResource("2")
text = "(Zurück an den Tisch)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_dance"]
script = ExtResource("1")
id = &"dance"
text = "Ein Tanz? Ich tanze nur mit Protokoll. … Ach, was soll's. Kathrein steht nicht im Gesetz."
choices = Array[ExtResource("2")]([SubResource("p8_dance_c01")])

[sub_resource type="Resource" id="p8_story_2_meet_c01"]
script = ExtResource("2")
text = "Danke."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_2_meet"]
script = ExtResource("1")
id = &"story_2_meet"
text = "Hier. Von hier sieht man das Dach vom Amtshaus, wenn die Linde kein Laub hat. Das genügt. Und das hier ist der Gemeindeschlüssel zum Archiv. Die Hälfte der Akten da drin gehört der Gemeinde. Die andere Hälfte dem Pfarrer, aber das muss er nicht wissen."
choices = Array[ExtResource("2")]([SubResource("p8_story_2_meet_c01")])

[sub_resource type="Resource" id="p8_story_3_meet_c01"]
script = ExtResource("2")
text = "(Trinken)"
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_3_meet"]
script = ExtResource("1")
id = &"story_3_meet"
text = "Prost. Meine Frau liegt unten auf dem alten Kirchhof bei St. Gallus, wo kein Totengräber mehr gräbt. Der Efeu ist über den Stein. Ich lasse ihn. Sie mochte Efeu. Ich nicht. Wir waren uns selten einig, und trotzdem."
choices = Array[ExtResource("2")]([SubResource("p8_story_3_meet_c01")])

[sub_resource type="Resource" id="p8_story_1_turn_in_c01"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="p8_node_story_1_turn_in"]
script = ExtResource("1")
id = &"story_1_turn_in"
text = "Diskret überreicht. Danke. Amtlich hat es nicht stattgefunden."
choices = Array[ExtResource("2")]([SubResource("p8_story_1_turn_in_c01")])

[sub_resource type="Resource" id="v_mayor_c001"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_start"]
script = ExtResource("1")
id = &"start"
text = "Fenner, Gottlieb, Schultheiß der Gemeinde Hollerbrück. Bitte, treten Sie näher. Es ist mir eine Freude und, wenn ich so sagen darf, eine Notwendigkeit, Sie endlich persönlich in Augenschein zu nehmen. Die Gemeinde hat ein Anliegen. Genauer: zwei. Genauer gesagt: ein Grundstück."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c001")])
conditions = Array[String](["!met:mayor"])
fallback_next = &"greet_disreputable"
actions = Array[String](["meet:mayor", "talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c002"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_greet_disreputable"]
script = ExtResource("1")
id = &"greet_disreputable"
text = "Totengräber. Es liegen Beschwerden vor. Schriftlich. Ich bin verpflichtet, das zu erwähnen, und hiermit erwähnt. Was wünschen Sie?"
choices = Array[ExtResource("2")]([SubResource("v_mayor_c002")])
conditions = Array[String](["rep_tier:disreputable"])
fallback_next = &"greet_unremarkable"
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c003"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_greet_unremarkable"]
script = ExtResource("1")
id = &"greet_unremarkable"
text = "Guten Tag. Die Amtsstube steht Ihnen offen, im Rahmen der Öffnungszeiten."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c003")])
conditions = Array[String](["rep_tier:unremarkable"])
fallback_next = &"greet_respected"
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c004"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_greet_respected"]
script = ExtResource("1")
id = &"greet_respected"
text = "Ah, der Totengräber. Die Gemeinde ist zufrieden, das darf ich amtlich sagen. Nehmen Sie Platz. Der Stuhl wackelt, das ist nicht amtlich."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c004")])
conditions = Array[String](["rep_tier:respected"])
fallback_next = &"greet_esteemed"
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c005"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_greet_esteemed"]
script = ExtResource("1")
id = &"greet_esteemed"
text = "Totengräber! Ich habe Ihren Namen gestern zweimal ins Protokoll geschrieben. Lobend. Das ist in Hollerbrück selten wie eine Brücke ohne Löcher."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c005")])
conditions = Array[String](["rep_tier:esteemed"])
fallback_next = &"greet_renowned"
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c006"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_greet_renowned"]
script = ExtResource("1")
id = &"greet_renowned"
text = "Mein verehrter Totengräber. Wenn die Gemeinde Ihnen eine Ehrenbürgerschaft antragen könnte, hätte ich den Antrag schon formuliert. Leider fehlt die Satzung. Ich arbeite daran."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c006")])
actions = Array[String](["talked:mayor"])

[sub_resource type="Resource" id="v_mayor_c007"]
script = ExtResource("2")
text = "[Auftrag] Der Lindenacker"
next = &"o_o_fenner_linden"
conditions = Array[String](["order_offerable:o_fenner_linden"])

[sub_resource type="Resource" id="v_mayor_c008"]
script = ExtResource("2")
text = "[Auftrag] Die Brunnenfassung"
next = &"o_o_fenner_well"
conditions = Array[String](["order_offerable:o_fenner_well"])

[sub_resource type="Resource" id="v_mayor_c009"]
script = ExtResource("2")
text = "[Auftrag] Die Holderbrücke"
next = &"o_o_fenner_bridge"
conditions = Array[String](["order_offerable:o_fenner_bridge"])

[sub_resource type="Resource" id="v_mayor_c010"]
script = ExtResource("2")
text = "[Auftrag] Die Beine des Schultheißen"
next = &"o_o_fenner_dropsy"
conditions = Array[String](["order_offerable:o_fenner_dropsy"])

[sub_resource type="Resource" id="v_mayor_c011"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Münzen und Bretter"
next = &"t_o_fenner_bridge"
conditions = Array[String](["order_ready:o_fenner_bridge"])
actions = Array[String](["order_turn_in:o_fenner_bridge"])

[sub_resource type="Resource" id="v_mayor_c012"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: das Pulver"
next = &"t_o_fenner_dropsy"
conditions = Array[String](["order_ready:o_fenner_dropsy"])
actions = Array[String](["order_turn_in:o_fenner_dropsy"])

[sub_resource type="Resource" id="v_mayor_c013"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Holz für den Gemeindezaun"
next = &"t_ob_wood"
conditions = Array[String](["order_ready:ob_wood"])
actions = Array[String](["order_turn_in:ob_wood"])

[sub_resource type="Resource" id="v_mayor_c014"]
script = ExtResource("2")
text = "[Auftrag] Hier ist, was du wolltest: Steine für den Kirchweg"
next = &"t_ob_stone"
conditions = Array[String](["order_ready:ob_stone"])
actions = Array[String](["order_turn_in:ob_stone"])

[sub_resource type="Resource" id="v_mayor_c015"]
script = ExtResource("2")
text = "Für die Armenkasse. (5 Münzen)"
next = &"donated"
conditions = Array[String](["village_can:donate"])
actions = Array[String](["donate"])

[sub_resource type="Resource" id="v_mayor_c016"]
script = ExtResource("2")
text = "Die Abschrift des Sterbebuchs …"
next = &"register"
conditions = Array[String](["rel_tier:mayor:trusted", "!clue_known:c_v_deathbook"])

[sub_resource type="Resource" id="v_mayor_c017"]
script = ExtResource("2")
text = "Wer war vor mir Totengräber?"
next = &"lorenz"

[sub_resource type="Resource" id="v_mayor_c018"]
script = ExtResource("2")
text = "Ich hab dir etwas mitgebracht."
actions = Array[String](["open_gifts:mayor"])

[sub_resource type="Resource" id="v_mayor_c019"]
script = ExtResource("2")
text = "Auf Wiedersehen."
next = &"bye"

[sub_resource type="Resource" id="v_mayor_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "Womit kann die Gemeinde dienen?"
choices = Array[ExtResource("2")]([SubResource("v_mayor_c007"), SubResource("v_mayor_c008"), SubResource("v_mayor_c009"), SubResource("v_mayor_c010"), SubResource("v_mayor_c011"), SubResource("v_mayor_c012"), SubResource("v_mayor_c013"), SubResource("v_mayor_c014"), SubResource("v_mayor_c015"), SubResource("v_mayor_c016"), SubResource("v_mayor_c017"), SubResource("p8_menu_menu_01"), SubResource("p8_menu_menu_02"), SubResource("p8_menu_menu_03"), SubResource("p8_menu_menu_04"), SubResource("p8_menu_menu_05"), SubResource("p8_menu_menu_06"), SubResource("p8_menu_menu_07"), SubResource("p8_menu_menu_08"), SubResource("p8_menu_menu_09"), SubResource("p8_menu_menu_10"), SubResource("p8_menu_menu_11"), SubResource("p8_menu_menu_12"), SubResource("p8_menu_menu_13"), SubResource("p8_menu_menu_14"), SubResource("p8_menu_menu_15"), SubResource("p8_menu_menu_16"), SubResource("p8_menu_menu_17"), SubResource("v_mayor_c018"), SubResource("v_mayor_c019")])

[sub_resource type="Resource" id="v_mayor_c020"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_fenner_linden_yes"
actions = Array[String](["order_accept:o_fenner_linden"])

[sub_resource type="Resource" id="v_mayor_c021"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_linden"]
script = ExtResource("1")
id = &"o_o_fenner_linden"
text = "Der Lindenacker. Ein Stück Gemeindewald südlich Ihrer Ostwiese, wo früher die alte Linde stand. Die Gemeinde überlässt es dem Friedhof, unentgeltlich, mit der Auflage, es urbar zu machen: eine Pforte, vier Stümpfe, drei Brombeerhecken, zwei Steinhaufen. Danach weiht es der Pfarrer. Acht Stellen. Unterschreiben Sie hier. Nein, hier."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c020"), SubResource("v_mayor_c021")])

[sub_resource type="Resource" id="v_mayor_c022"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_linden_yes"]
script = ExtResource("1")
id = &"o_o_fenner_linden_yes"
text = "Vermerkt. Der Grund gehört ab heute dem Friedhof. Ich lasse es Osric ausrichten, der erzählt es ohnehin herum."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c022")])

[sub_resource type="Resource" id="v_mayor_c023"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_fenner_well_yes"
actions = Array[String](["order_accept:o_fenner_well"])

[sub_resource type="Resource" id="v_mayor_c024"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_well"]
script = ExtResource("1")
id = &"o_o_fenner_well"
text = "Die Brunnenfassung am Anger bröckelt, Totengräber. Die Gemeinde braucht vier Werksteine. Sie haben, wie man hört, eine Steinmetzbank. Geben Sie die Steine bei Esch ab, er setzt sie. Vier Tage, dann tagt der Rat, und ich möchte etwas vorweisen."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c023"), SubResource("v_mayor_c024")])

[sub_resource type="Resource" id="v_mayor_c025"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_well_yes"]
script = ExtResource("1")
id = &"o_o_fenner_well_yes"
text = "Vier Werksteine, bei Esch. Ich notiere: beauftragt."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c025")])

[sub_resource type="Resource" id="v_mayor_c026"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_fenner_bridge_yes"
actions = Array[String](["order_accept:o_fenner_bridge"])

[sub_resource type="Resource" id="v_mayor_c027"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_bridge"]
script = ExtResource("1")
id = &"o_o_fenner_bridge"
text = "Die Holderbrücke. Zwei Bohlen sind morsch, eine dritte ist fort, keiner weiß wohin, ich vermute Kehr. Zwanzig Münzen und sechs Bretter. Die Gemeinde kann es nicht, die Armenkasse darf es nicht, also frage ich Sie. Inoffiziell. Mit Quittung."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c026"), SubResource("v_mayor_c027")])

[sub_resource type="Resource" id="v_mayor_c028"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_bridge_yes"]
script = ExtResource("1")
id = &"o_o_fenner_bridge_yes"
text = "Ich stelle die Quittung schon aus. Für den Fall."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c028")])

[sub_resource type="Resource" id="v_mayor_c029"]
script = ExtResource("2")
text = "Ich kümmere mich darum."
next = &"o_o_fenner_dropsy_yes"
actions = Array[String](["order_accept:o_fenner_dropsy"])

[sub_resource type="Resource" id="v_mayor_c030"]
script = ExtResource("2")
text = "Später."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_dropsy"]
script = ExtResource("1")
id = &"o_o_fenner_dropsy"
text = "Totengräber, unter vier Augen. Meine Beine. Abends sind sie wie Teig. Quast sagt Wassersucht und will mich zur Ader lassen, und dann redet das ganze Dorf. Man sagt, Sie haben jetzt ein Pult, und Quasts Rezepte. Ein Pulver. Sagen Sie es keinem."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c029"), SubResource("v_mayor_c030")])

[sub_resource type="Resource" id="v_mayor_c031"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_o_o_fenner_dropsy_yes"]
script = ExtResource("1")
id = &"o_o_fenner_dropsy_yes"
text = "Das bleibt unter uns. Amtlich unter uns."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c031")])

[sub_resource type="Resource" id="v_mayor_c032"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_t_o_fenner_bridge"]
script = ExtResource("1")
id = &"t_o_fenner_bridge"
text = "Zwanzig Münzen. Ich zähle: zwanzig. Und sechs Bretter, ich zähle: sechs. Die Gemeinde dankt, schriftlich und mündlich, in dieser Reihenfolge."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c032")])

[sub_resource type="Resource" id="v_mayor_c033"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_t_o_fenner_dropsy"]
script = ExtResource("1")
id = &"t_o_fenner_dropsy"
text = "Ich danke Ihnen. Das hat es nicht gegeben, verstehen Sie. Amtlich nicht."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c033")])

[sub_resource type="Resource" id="v_mayor_c034"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_t_ob_wood"]
script = ExtResource("1")
id = &"t_ob_wood"
text = "Zehn Scheite für den Gemeindezaun, ordnungsgemäß. Ich trage Sie ein."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c034")])

[sub_resource type="Resource" id="v_mayor_c035"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_t_ob_stone"]
script = ExtResource("1")
id = &"t_ob_stone"
text = "Acht Steine. Der Kirchweg dankt, und ich vertrete ihn hiermit."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c035")])

[sub_resource type="Resource" id="v_mayor_c036"]
script = ExtResource("2")
text = "Gern."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_donated"]
script = ExtResource("1")
id = &"donated"
text = "Fünf Münzen für die Armenkasse. Ich zähle: eins, zwei, drei, vier, fünf. Ich trage es ein, mit Ihrem Namen. Die Armen werden es nicht lesen, aber ich."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c036")])

[sub_resource type="Resource" id="v_mayor_c037"]
script = ExtResource("2")
text = "(Die Abschrift lesen)"
next = &"register_read"
actions = Array[String](["add_clue:c_v_deathbook"])

[sub_resource type="Resource" id="v_mayor_node_register"]
script = ExtResource("1")
id = &"register"
text = "Die Abschrift des Sterbebuchs liegt auf dem Lesepult, für die Gemeinde. Sie dürfen hineinsehen, Totengräber, Sie gehören ja gewissermaßen zum Amt. Nur nichts herausreißen. Das hat einmal einer getan. Ich weiß bis heute nicht, wer."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c037")])

[sub_resource type="Resource" id="v_mayor_c038"]
script = ExtResource("2")
text = "Mir auch nicht."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_register_read"]
script = ExtResource("1")
id = &"register_read"
text = "Sie sehen das auch? Diese Striche am Rand? Ich habe sie für einen Schreibfehler des Pfarrers gehalten. Aber der Pfarrer macht keine Schreibfehler, er macht nur zu viele Worte. Und die Tinte – nein. Das ist ältere Tinte. Das gefällt mir nicht, Totengräber. Amtlich nicht."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c038")])

[sub_resource type="Resource" id="v_mayor_c039"]
script = ExtResource("2")
text = "Verstehe."
next = &"menu"

[sub_resource type="Resource" id="v_mayor_node_lorenz"]
script = ExtResource("1")
id = &"lorenz"
text = "Lorenz Aschau. Einunddreißig Jahre im Dienst. Die Akte ist geschlossen: verschwunden, nicht verstorben, das ist ein Unterschied, der der Gemeinde zwölf Münzen Begräbnisgeld spart. Ich sage das ungern. Ich sage es, weil es stimmt."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c039")])

[sub_resource type="Resource" id="v_mayor_c040"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_mayor_node_bye"]
script = ExtResource("1")
id = &"bye"
text = "Auf Wiedersehen, mein Freund. Und wenn Sie einmal etwas schriftlich brauchen: Ich siegele es Ihnen. Umsonst. Das darf ich eigentlich nicht."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c040")])
conditions = Array[String](["rel_tier:mayor:friend"])
fallback_next = &"bye_plain"

[sub_resource type="Resource" id="v_mayor_c041"]
script = ExtResource("2")
text = "(Gehen)"

[sub_resource type="Resource" id="v_mayor_node_bye_plain"]
script = ExtResource("1")
id = &"bye_plain"
text = "Die Amtsstube schließt um sechzehn Uhr. Danach bin ich an der Gemeindetafel. Danach im Holderkrug. Danach privat."
choices = Array[ExtResource("2")]([SubResource("v_mayor_c041")])

[resource]
script = ExtResource("3")
id = &"v_mayor"
speaker_name = "Schultheiß Gottlieb Fenner"
start_node = &"p8_row3"
nodes = Array[ExtResource("1")]([SubResource("v_mayor_node_start"), SubResource("v_mayor_node_greet_disreputable"), SubResource("v_mayor_node_greet_unremarkable"), SubResource("v_mayor_node_greet_respected"), SubResource("v_mayor_node_greet_esteemed"), SubResource("v_mayor_node_greet_renowned"), SubResource("v_mayor_node_menu"), SubResource("v_mayor_node_o_o_fenner_linden"), SubResource("v_mayor_node_o_o_fenner_linden_yes"), SubResource("v_mayor_node_o_o_fenner_well"), SubResource("v_mayor_node_o_o_fenner_well_yes"), SubResource("v_mayor_node_o_o_fenner_bridge"), SubResource("v_mayor_node_o_o_fenner_bridge_yes"), SubResource("v_mayor_node_o_o_fenner_dropsy"), SubResource("v_mayor_node_o_o_fenner_dropsy_yes"), SubResource("v_mayor_node_t_o_fenner_bridge"), SubResource("v_mayor_node_t_o_fenner_dropsy"), SubResource("v_mayor_node_t_ob_wood"), SubResource("v_mayor_node_t_ob_stone"), SubResource("v_mayor_node_donated"), SubResource("v_mayor_node_register"), SubResource("v_mayor_node_register_read"), SubResource("v_mayor_node_lorenz"), SubResource("v_mayor_node_bye"), SubResource("v_mayor_node_bye_plain"), SubResource("p8_node_p8_row3"), SubResource("p8_node_p8_robber"), SubResource("p8_node_p8_robber_watch"), SubResource("p8_node_p8_robber_let_go"), SubResource("p8_node_p8_hill"), SubResource("p8_node_story_1"), SubResource("p8_node_story_1_yes"), SubResource("p8_node_story_1_done"), SubResource("p8_node_story_2"), SubResource("p8_node_story_2_yes"), SubResource("p8_node_story_2_done"), SubResource("p8_node_story_3"), SubResource("p8_node_story_3_yes"), SubResource("p8_node_story_3_done"), SubResource("p8_node_story_cross"), SubResource("p8_node_listen"), SubResource("p8_node_favor"), SubResource("p8_node_favor_done"), SubResource("p8_node_o_of_fenner_return_1"), SubResource("p8_node_o_of_fenner_return_1_yes"), SubResource("p8_node_t_of_fenner_return_1"), SubResource("p8_node_o_of_fenner_return_2"), SubResource("p8_node_o_of_fenner_return_2_yes"), SubResource("p8_node_t_of_fenner_return_2"), SubResource("p8_node_dance"), SubResource("p8_node_story_2_meet"), SubResource("p8_node_story_3_meet"), SubResource("p8_node_story_1_turn_in")])
