[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_node.gd" id="1"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_choice.gd" id="2"]
[ext_resource type="Script" path="res://src/systems/dialogue/dialogue_data.gd" id="3"]

[sub_resource type="Resource" id="kin_kehr_first_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_first"]
script = ExtResource("1")
id = &"first"
text = "Grüß Gott. Ich bleib nicht lange. Bei uns hat nie einer lange gestanden. Kehr. Martha. Sie kennen uns, Sie haben einen von uns hingelegt."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_first_c01")])
conditions = Array[String](["!flag:p8_met_kin_kehr"])
fallback_next = &"greet"
actions = Array[String](["set_flag:p8_met_kin_kehr"])

[sub_resource type="Resource" id="kin_kehr_greet_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_greet"]
script = ExtResource("1")
id = &"greet"
text = "Grüß Gott. Ich bleib nicht lange."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_greet_c01")])

[sub_resource type="Resource" id="kin_kehr_menu_c01"]
script = ExtResource("2")
text = "[Trinkgeld] …"
next = &"tip"
conditions = Array[String](["tip_due"])
actions = Array[String](["tip_hand"])

[sub_resource type="Resource" id="kin_kehr_menu_c02"]
script = ExtResource("2")
text = "[Wunsch] Kann ich etwas für das Grab tun?"
next = &"wish"
conditions = Array[String](["wish_offerable"])
actions = Array[String](["wish_offer"])

[sub_resource type="Resource" id="kin_kehr_menu_c03"]
script = ExtResource("2")
text = "Wer liegt hier?"
next = &"who"

[sub_resource type="Resource" id="kin_kehr_menu_c04"]
script = ExtResource("2")
text = "Ich lass Sie allein."

[sub_resource type="Resource" id="kin_kehr_node_menu"]
script = ExtResource("1")
id = &"menu"
text = "(Martha wartet.)"
choices = Array[ExtResource("2")]([SubResource("kin_kehr_menu_c01"), SubResource("kin_kehr_menu_c02"), SubResource("kin_kehr_menu_c03"), SubResource("kin_kehr_menu_c04")])

[sub_resource type="Resource" id="kin_kehr_wish_c01"]
script = ExtResource("2")
text = "Das mache ich."
next = &"wish_yes"
actions = Array[String](["wish_accept"])

[sub_resource type="Resource" id="kin_kehr_wish_c02"]
script = ExtResource("2")
text = "Ich kann es nicht versprechen."
next = &"wish_no"

[sub_resource type="Resource" id="kin_kehr_node_wish"]
script = ExtResource("1")
id = &"wish"
text = "Ein paar Blumen. Heide, wenn's geht, die hält den Winter. Ich komm in drei Tagen wieder."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_wish_c01"), SubResource("kin_kehr_wish_c02")])

[sub_resource type="Resource" id="kin_kehr_wish_yes_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_wish_yes"]
script = ExtResource("1")
id = &"wish_yes"
text = "Gut. Ich sag's keinem. Dann ist es eine Überraschung, auch für mich."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_wish_yes_c01")])

[sub_resource type="Resource" id="kin_kehr_wish_no_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_wish_no"]
script = ExtResource("1")
id = &"wish_no"
text = "Na ja. Sie haben viele."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_wish_no_c01")])

[sub_resource type="Resource" id="kin_kehr_tip_c01"]
script = ExtResource("2")
text = "Danke."
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_tip"]
script = ExtResource("1")
id = &"tip"
text = "Heide. Sie haben es nicht vergessen. Hier, nimm. Nein, nimm es. Ich hab's schon im Korb gezählt."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_tip_c01")])

[sub_resource type="Resource" id="kin_kehr_who_c01"]
script = ExtResource("2")
text = "…"
next = &"menu"

[sub_resource type="Resource" id="kin_kehr_node_who"]
script = ExtResource("1")
id = &"who"
text = "Einer von uns. Mehr muss man nicht wissen. Er hat Laub nie leiden können, und jetzt liegt er drunter. So ist das."
choices = Array[ExtResource("2")]([SubResource("kin_kehr_who_c01")])

[resource]
script = ExtResource("3")
id = &"kin_kehr"
speaker_name = "Martha Kehr"
start_node = &"first"
nodes = Array[ExtResource("1")]([SubResource("kin_kehr_node_first"), SubResource("kin_kehr_node_greet"), SubResource("kin_kehr_node_menu"), SubResource("kin_kehr_node_wish"), SubResource("kin_kehr_node_wish_yes"), SubResource("kin_kehr_node_wish_no"), SubResource("kin_kehr_node_tip"), SubResource("kin_kehr_node_who")])
