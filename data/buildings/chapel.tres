[gd_resource type="Resource" script_class="BuildingData" load_steps=10 format=3]

[ext_resource type="Script" path="res://src/systems/buildings/building_data.gd" id="1"]
[ext_resource type="Script" path="res://src/systems/buildings/building_level_data.gd" id="2"]
[ext_resource type="PackedScene" path="res://assets/models/buildings/ph_bld_chapel_ruin.glb" id="m0"]
[ext_resource type="PackedScene" path="res://assets/models/buildings/ph_bld_chapel_l1.glb" id="m1"]
[ext_resource type="PackedScene" path="res://assets/models/buildings/ph_bld_chapel_l2.glb" id="m2"]
[ext_resource type="PackedScene" path="res://assets/models/buildings/ph_bld_chapel_l3.glb" id="m3"]

[sub_resource type="Resource" id="level_1"]
script = ExtResource("2")
level = 1
model = ExtResource("m1")
title = "Kapelle unter Dach"
inputs = Dictionary[StringName, int]({&"wood": 10, &"stone": 8, &"clay": 2, &"linen": 2, &"iron_fittings": 2})
coins = 25
minutes = 240
coin_part_label = "Dachschiefer"
text = "Ein Dach über den alten Mauern, ein Altar mit Tuch und ein Katafalk davor. Hier kann der Totengräber die Aussegnung selbst halten."
adds = PackedStringArray("Dach und Tür", "Altar mit Altartuch", "Katafalk", "2 rohe Bänke", "Aussegnung (Gebühr 3, Ruf +1)", "Andacht (+1)")

[sub_resource type="Resource" id="level_2"]
script = ExtResource("2")
level = 2
model = ExtResource("m2")
title = "Glocke und Gestühl"
inputs = Dictionary[StringName, int]({&"wood": 8, &"workstone": 3, &"iron_bar": 2})
coins = 30
minutes = 210
coin_part_label = "Totenglocke aus der Stadt"
text = "Ein Dachreiter mit Totenglocke und richtige Kirchenbänke. Zur Aussegnung kommen jetzt Leute aus Hollerbrück."
adds = PackedStringArray("Dachreiter mit Glocke", "4 Kirchenbänke", "2 Trauergäste", "Gebühr 5, Ruf +2", "Andacht +2")

[sub_resource type="Resource" id="level_3"]
script = ExtResource("2")
level = 3
model = ExtResource("m3")
title = "Licht im Chor"
inputs = Dictionary[StringName, int]({&"workstone": 4, &"gold_leaf": 2, &"linen": 3, &"iron_fittings": 2})
coins = 40
minutes = 240
coin_part_label = "bleigefasstes Chorfenster"
text = "Ein farbiges Chorfenster, ein Ewiges Licht und vor der Tür ein Totenleuchter, der nachts brennt."
adds = PackedStringArray("Farbiges Chorfenster", "Totenleuchter vor der Tür", "Ewiges Licht", "4 Trauergäste", "Gebühr 7, Ruf +3", "Andacht +3")

[resource]
script = ExtResource("1")
id = &"chapel"
model_site = ExtResource("m0")
display_name = "Kapelle"
order = 2
site_id = "site_chapel"
door_id = "door_chapel"
room_id = &"chapel"
levels = Array[ExtResource("2")]([SubResource("level_1"), SubResource("level_2"), SubResource("level_3")])
allows_corpse = true
prompt_enter = "[E] Kapelle betreten"
prompt_exit = "[E] Hinausgehen"
