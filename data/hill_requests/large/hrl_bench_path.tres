title = "Ein Platz zum Ausruhen"
request_text = "Theres Mangold: „Der Weg hinauf ist lang für alte Knie. Mach hinten ein Stück frei, stell eine Bank hin und harke unter der Eiche das Laub weg. Dann setz ich mich auch einmal zu den Meinen.“"
thanks_text = "Theres hat sich gesetzt, sagt Osric. Ziemlich lange. Dann hat sie ihm Samen für dich mitgegeben."
