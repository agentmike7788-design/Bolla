title = "Namen, die man noch lesen kann"
request_text = "Pfarrer Lenz: „Auf den alten Steinen im Alten Hof kann man die Namen nicht mehr lesen. Hau zwei neue, schlicht, ich schreib die Namen dazu. Mach den Boden dazwischen frei. Und hör nachts hin, ob einer von ihnen etwas sagt.“"
thanks_text = "Lenz hat die beiden Namen ins Sterbebuch nachgetragen, sagt Osric. „Spät, aber ordentlich.“"
