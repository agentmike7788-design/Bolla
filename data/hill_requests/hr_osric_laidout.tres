title = "Ordentlich aufgebahrt"
request_text = "Osric: „Den letzten hab ich dir abgeladen, und er sah aus wie ich nach dem dritten Schnaps. Mach den nächsten ordentlich – gewaschen, gekleidet, aufgebahrt. So will ich sie in Erinnerung.“"
thanks_text = "Osric hat es gehört: %s ging gewaschen, gekleidet und aufgebahrt. „So ist es recht“, sagt er. Mehr sagt er nicht."
