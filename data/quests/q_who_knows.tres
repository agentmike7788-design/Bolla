[sub_resource type="Resource" id="Resource_6l6uo"]
script = ExtResource("1_ntiby")
id = &"away"
title = "Über den Hügel"
summary = "Johann ist fortgegangen, wie Lorenz, mit einem Brief ohne Namen und einem Bündel über der Schulter."
flag = &"q_end_away"
settle_on = &"sieber_gone"
closing_line = "Johann ist über den Hügel gegangen. Ob er angekommen ist, steht in keinem Brief, den du bekommen hast. Noch nicht."

[sub_resource type="Resource" id="Resource_2hu07"]
script = ExtResource("1_ntiby")
id = &"stay"
title = "Bei Grete"
summary = "Johann ist geblieben. Du hast an zwei Abenden mit ihm gesessen und ihm das Grab neben Grete gemacht."
flag = &"q_end_stay"
settle_on = &"sieber_buried"
closing_line = "Johann hat sich nicht beeilt. Du hast ihm die Erde so tief gemacht, wie man es kann. Wann der Nächste kommt, steht in keinem Heft, das du hast."

[sub_resource type="Resource" id="Resource_7b5ma"]
script = ExtResource("1_ntiby")
id = &"public"
title = "Vor der Gemeinde"
summary = "Fenner hat einen Wächter vor die Siebers gestellt und aufgeschrieben, wer kam. Es kamen dieselben wie immer. Johann ist trotzdem gestorben."
flag = &"q_end_public"
settle_on = &"sieber_buried"
closing_line = "Fenner hat jetzt ein Buch für Lichter. Es hat sechs Einträge. Lorenz hatte auch sechs."

[sub_resource type="Resource" id="Resource_4rxuc"]
script = ExtResource("1_ntiby")
id = &"silent"
title = "Geschwiegen"
summary = "Du hast nichts gesagt. Das Dorf hat seinen eigenen Lauf, und Johann den seinen."
flag = &"q_end_silent"
settle_on = &"sieber_buried"
closing_line = "Du hast die Liste gelesen und zugeklappt. Das Dorf hat sie nie gesehen. Das Licht schon."

[sub_resource type="Resource" id="Resource_43s6v"]
script = ExtResource("3_8qe07")
id = &"h1"
title = "Die Rückseite"
hint = "Lies Lorenz' Kladde am Schreibpult in der Hütte. Fehlt sie, frag den Pfarrer."
complete_on = &"note"
complete_ids = Array[StringName]([&"kladde_read"])

[sub_resource type="Resource" id="Resource_d32uw"]
script = ExtResource("3_8qe07")
id = &"h2"
title = "Wer liegt unter dem Datum?"
hint = "Vergleich das Grabregister mit der Liste – und an den Gräbern die Daten auf den Steinen."
complete_on = &"note"
complete_ids = Array[StringName]([&"date_grave"])
complete_count = 5

[sub_resource type="Resource" id="Resource_kj665"]
script = ExtResource("3_8qe07")
id = &"h3"
title = "Wer hat das Licht gesehen?"
hint = "Frag die, die nachts die Fenster sehen. Drei genügen, um es zu wissen."
complete_on = &"insight"
complete_ids = Array[StringName]([&"i_light_before"])

[sub_resource type="Resource" id="Resource_26gbm"]
script = ExtResource("3_8qe07")
id = &"h4"
title = "„S.“"
hint = "Unter dem letzten Datum liegt noch keiner. Drei Häuser im Dorf fangen mit S an."
complete_on = &"flag"
complete_ids = Array[StringName]([&"q_sieber_marked"])

