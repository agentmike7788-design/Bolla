id = &"q_who_knows"
kind = &"main"
title = "Wer weiß, wann?"
summary = "Auf der Rückseite von Lorenz' Kladde stehen sechs Daten und je ein Buchstabe. Unter fünf Daten liegt einer auf dem Hügel. Unter dem letzten noch keiner."
