[resource]
script = ExtResource("2_l1j22")
id = &"q_letters"
title = "Briefe ohne Antwort"
summary = "In den Taschen der Toten stecken Briefe an die Lebenden, und die Post bringt Briefe an die Toten. Du bist der Einzige, der beides in der Hand hat."
