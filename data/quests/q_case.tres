[resource]
script = ExtResource("2_4w7r5")
id = &"q_case"
title = "Der Herr mit dem Koffer"
summary = "Ein Herr aus der Stadt wartet am Tor und stellt Fragen, die man in Hollerbrück nicht stellt. Er zahlt immer passend."
giver = &"stranger"
open_conditions = PackedStringArray("flag:p9_open")
steps = Array[ExtResource("3_4ex4l")]([SubResource("Resource_sgpfg"), SubResource("Resource_kenoq"), SubResource("Resource_wiemd"), SubResource("Resource_vvkf0"), SubResource("Resource_1h16s")])
