title = "Der Koffer"
hint = "Rosine hat einen Koffer, den sie nicht anfassen will."
complete_on = &"order"
complete_ids = Array[StringName]([&"oq_case_return"])
order_ids = Array[StringName]([&"oq_case_return"])

