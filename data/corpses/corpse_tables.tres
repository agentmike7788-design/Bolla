[gd_resource type="Resource" script_class="CorpseTables" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/corpse/corpse_tables.gd" id="1"]

[resource]
script = ExtResource("1")
first_names = PackedStringArray("Anselm", "Berthold", "Cordula", "Dietlinde", "Egbert", "Frieda", "Gottlieb", "Hedwig", "Ignaz", "Josepha", "Kunibert", "Liesel", "Mechthild", "Notburga", "Ottilie", "Pankraz", "Roswitha", "Sebald", "Theres", "Ulrich", "Walburga", "Wendelin")
last_names = PackedStringArray("Moosbacher", "Distelmeier", "Holzapfel", "Brenneisen", "Weidenfeller", "Kesselring", "Hagedorn", "Rabenstein", "Eschenbach", "Mühlhauser", "Nebelung", "Kornblum", "Schattauer", "Wolfsgruber", "Krähwinkel", "Pechstein", "Dornbusch", "Unkenfeld", "Hollerbach", "Brunnhuber")
female_first_names = PackedStringArray("Cordula", "Dietlinde", "Frieda", "Hedwig", "Josepha", "Liesel", "Mechthild", "Notburga", "Ottilie", "Roswitha", "Theres", "Walburga")
old_age = 60
age_min = 18
age_max = 88
causes = Array[Dictionary]([{"id": &"fever", "label": "Fieber", "description": "Das Sumpffieber aus den Mooren. Die Haut ist fahl und wächsern, die Lippen sind rissig vom Durst der letzten Nächte.", "weight": 1.5, "decay_mult": 1.0, "base_payment": 3}, {"id": &"drowned_millpond", "label": "Ertrunken im Mühlteich", "description": "Kalt und aufgedunsen, Entengrütze im Haar. Der Müller hat den Leib am Wehr aus dem Wasser gezogen.", "weight": 1.0, "decay_mult": 1.5, "base_payment": 4}, {"id": &"fall_hayloft", "label": "Sturz vom Heuboden", "description": "Das Genick gebrochen, noch Halme an der Kleidung. Die Leiter stand wohl zu steil.", "weight": 1.0, "decay_mult": 1.0, "base_payment": 3}, {"id": &"old_age", "label": "Altersschwäche", "description": "Friedlich eingeschlafen, die Hände über der Brust gefaltet. Jemand hat die Augen bereits geschlossen.", "weight": 1.5, "decay_mult": 0.75, "base_payment": 2}, {"id": &"poisoned", "label": "Vergiftet?", "description": "Bläuliche Fingernägel und ein bitterer Geruch um den Mund. Im Dorf will niemand darüber reden.", "weight": 0.5, "decay_mult": 1.25, "base_payment": 4}, {"id": &"coach_accident", "label": "Kutschenunglück", "description": "Im Hohlweg von der Postkutsche erfasst. Prellungen überall, ein Arm ist zerschlagen.", "weight": 0.75, "decay_mult": 1.25, "base_payment": 3}])
traits = Array[Dictionary]([{"id": &"valuables", "label": "Wertsachen", "reveal_text": "In den Rocksaum eingenäht: ein kleiner Beutel mit Münzen. Niemand würde je erfahren, wohin er verschwunden ist.", "chance": 0.35}, {"id": &"letter", "label": "Brief", "reveal_text": "Ein gefalteter Brief, das Siegel ungebrochen. Die Tinte ist verlaufen – nur „…komm nicht zurück nach Hollerbrück“ ist noch zu lesen.", "chance": 0.25}, {"id": &"tattoo", "label": "Tätowierung", "reveal_text": "Auf dem Unterarm eine verblasste Tätowierung: ein Anker, umschlungen von einer Schlange. Seeleute kommen selten so weit ins Land.", "chance": 0.2}, {"id": &"strange_wound", "label": "Seltsame Wunde", "reveal_text": "Über dem Herzen ist ein Zeichen in die Haut geritzt – ein Kreis, von drei Linien durchbrochen. Die Wunde blutet nicht, und unter deinen Fingern fühlt sich die Haut noch warm an.", "chance": 0.15}])
forced_traits_by_day = Dictionary[int, PackedStringArray]({1: PackedStringArray(), 2: PackedStringArray("valuables"), 3: PackedStringArray("strange_wound"), 4: PackedStringArray("valuables", "letter"), 5: PackedStringArray("valuables", "tattoo")})
base_decay_per_hour = 0.05
delivery_minute = 460
valuables_coins_min = 5
valuables_coins_max = 8
