[gd_resource type="Resource" script_class="InsightData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/journal/insight_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"i_burn_it"
order = 8
title = "Verbrennt es"
question = "Was wollte der Zettel bei Quast?"
text = "Zweimal hat Quast ein gesundes, stilles Herz eines Gezeichneten eingelegt. Beide Male lag am nächsten Morgen ein Zettel vor seiner Tür, in derselben schrägen Hand wie die Warnbriefe: ‚Verbrennt es.‘ Lorenz will nicht, dass sie aufbewahrt werden."
requires = Array[StringName]([&"c_v_still_heart", &"c_warning_letter"])
sets_flag = &"insight_burn_it"
optional = true
rename_story = &""
rename_to = ""
