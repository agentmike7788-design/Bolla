[gd_resource type="Resource" script_class="InsightData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/journal/insight_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"i_still_writing"
order = 4
title = "Die Hand schreibt weiter"
question = "Wer schreibt jetzt?"
text = "Ein Warnbrief, drei Wochen nach Lorenz’ Verschwinden geschrieben – in seiner Hand. Entweder schreibt ein Toter, oder Lorenz ist nicht tot."
requires = Array[StringName]([&"c_letter_late", &"c_page_1"])
sets_flag = &"insight_still_writing"
optional = false
rename_story = &""
rename_to = ""
