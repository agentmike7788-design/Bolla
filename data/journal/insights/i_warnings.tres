[gd_resource type="Resource" script_class="InsightData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/journal/insight_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"i_warnings"
order = 1
title = "Wer die Warnbriefe schrieb"
question = "Wer warnt die Toten?"
text = "Dieselbe schräge Hand, dieselbe braune Tinte. Die Warnbriefe hat Lorenz Aschau geschrieben. Er wusste vorher, wen es trifft."
requires = Array[StringName]([&"c_warning_letter", &"c_page_1"])
sets_flag = &"insight_warnings"
optional = false
rename_story = &""
rename_to = ""
