script = ExtResource("1")
id = &"c_ferry_token"
title = "Die Fährmarke"
text = "Eine Blechmarke, darauf eine Schlange um einen Anker: ‚Moorfähre – Nachtfahrt – frei.‘ Auf der Rückseite, mit einem Nagel eingeritzt: ‚L. A. zahlt.‘"
