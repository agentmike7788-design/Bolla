[resource]
script = ExtResource("1")
id = &"c_v_hagedorn"
title = "Drei Wochen alt"
text = "Wiebke Hagedorns Zeichen ist frisch verheilt, etwa drei Wochen alt. In ihrer Schürze steckt ein Zettel: ‚Für den Totengräber. Linde, Mohn, Totenhemd. Und schau nach, wer mich besucht hat. – W. H.‘"
kind = &"mark"
order = 33
