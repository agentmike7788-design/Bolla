[resource]
script = ExtResource("1")
id = &"c_q_sieber"
title = "Bei den Siebers"
text = "Bei den Siebers, oben beim Alten. Keiner hat es angezündet. Es war einfach da, und um fünf war es weg. Johann sagt, er war's nicht. Er lügt nie, der Alte. Er ist zu langsam zum Lügen."
kind = &"talk"
order = 407
