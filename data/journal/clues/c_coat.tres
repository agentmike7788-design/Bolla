script = ExtResource("1")
id = &"c_coat"
title = "Lorenz’ Mantel"
text = "Ein langer, vielfach geflickter Totengräbermantel. Innen am Kragen, in verblichenem Garn gestickt: ‚L. Aschau‘. Osric hat ihn schon von Weitem erkannt."
