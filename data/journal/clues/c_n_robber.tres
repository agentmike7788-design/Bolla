[resource]
script = ExtResource("1")
id = &"c_n_robber"
title = "Wer zahlt den Grell?"
text = "Ein Herr mit einem Koffer. Er riecht nach Branntwein und zahlt für Frische. Er sagt, für die Wissenschaft. Mehr weiß der Grell nicht."
kind = &"talk"
order = 306
