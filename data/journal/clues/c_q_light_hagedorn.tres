script = ExtResource("1")
id = &"c_q_light_hagedorn"
title = "Licht bei der Hagedorn"
text = "Theres sah vom Laden aus ein Licht bei der Hagedorn, und die Alte war gesund wie ein Pferd. Man denkt sich bei Licht nichts. Das ist ja das Schlimme."
kind = &"talk"
order = 405
