[resource]
script = ExtResource("1")
id = &"c_six_pits"
title = "Sechs Gruben"
text = "Hinter der Hütte, im Holunderwinkel: sechs Gruben, sauber ausgehoben, längst eingesunken. Wer gräbt Gräber für Tote, die noch leben?"
kind = &"place"
order = 7
