[resource]
script = ExtResource("1")
id = &"c_v_still_heart"
title = "Ein Herz ohne Krankheit"
text = "Ein gesundes Herz eines Gezeichneten, still stehen geblieben. Quast: „Ich habe so ein Herz schon zweimal eingelegt. Beide Male lag morgens ein Zettel vor meiner Tür.“"
kind = &"note"
order = 36
