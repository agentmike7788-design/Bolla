[resource]
script = ExtResource("1")
id = &"c_trader_note"
title = "Ein Zettel an der Tür"
text = "Wer den Toten etwas nimmt, braucht jemanden, der es abnimmt. Ich komme nach elf an die Westmauer. Frag nach Ilse. – I. K."
kind = &"note"
order = 16
