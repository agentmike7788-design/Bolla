[resource]
script = ExtResource("1")
id = &"c_page_1"
title = "Eine Seite aus einer Kladde"
text = "Ein herausgerissenes Blatt, eng beschrieben, schräge Hand, braune Tinte: ‚M. Quendel – gezeichnet seit Lichtmess. Hab ihr zweimal geschrieben. Sie will nicht fort. Sie sagt, einer muss die Gräber der anderen gießen. – L. A.‘"
kind = &"page"
order = 4
