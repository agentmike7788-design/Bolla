[resource]
script = ExtResource("1")
id = &"c_elder_key"
title = "Der Schlüssel mit dem Holunderblatt"
text = "Ein rostiger Schlüssel an einer Lederschnur. In den Bart ist ein Holunderblatt gefeilt, mit ruhiger, geduldiger Hand. Irgendwo auf diesem Hügel gibt es ein Schloss, das dazu passt."
kind = &"object"
order = 6
