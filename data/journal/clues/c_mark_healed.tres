script = ExtResource("1")
id = &"c_mark_healed"
title = "Ein verheiltes Zeichen"
text = "Das Dreistrich-Zeichen über Ida Wernsteins Herzen ist längst vernarbt – blass und glatt wie eine alte Brandnarbe. Sie trug es seit Wochen, nicht erst seit ihrer letzten Stunde."
kind = &"mark"
order = 8
