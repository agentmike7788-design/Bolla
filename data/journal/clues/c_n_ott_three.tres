script = ExtResource("1")
id = &"c_n_ott_three"
title = "Drei Spuren"
text = "Quasts Fläschchen in der Tasche, ein Wachstropfen von Lenz' Kerze am Kragen, ein frisch gewaschenes Hemd unter dem Kittel. Drei waren bei Gerhard Ott, bevor er starb."
kind = &"mark"
order = 304
