[resource]
script = ExtResource("1")
id = &"c_crypt_draft"
title = "Der kalte Zug"
text = "Hinter dem Beinhaus eine zugemauerte Tür, jünger als das Gewölbe. Durch die Fugen zieht es kalt. Der Zug kommt von Nordosten, von unter dem Hof her, Richtung Birkenhang.

Am Rand, mit Bleistift: ‚Unter dem Birkenhang ist es nicht still.‘"
kind = &"place"
order = 20
