[resource]
script = ExtResource("1")
id = &"c_page_list"
title = "Die Liste der Sechs"
text = "Ins Mantelfutter eingenäht: die letzte Seite aus Lorenz’ Kladde. Sechs Namen – Quendel. Hemmerling. Wernstein. Uhlig. Dorn. Der sechste ist vom Moorwasser verwischt. Darunter: ‚Unter dem Birkenhang ist es nicht still.‘"
kind = &"page"
order = 15
