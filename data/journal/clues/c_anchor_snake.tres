[resource]
script = ExtResource("1")
id = &"c_anchor_snake"
title = "Anker und Schlange"
text = "Am Unterarm eine verblasste Tätowierung: ein Anker, um den sich eine Schlange windet. Grob mit Nadel und Ruß gestochen, vor vielen Jahren, von jemandem, der es nicht gelernt hatte."
kind = &"mark"
order = 3
