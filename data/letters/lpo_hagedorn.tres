[gd_resource type="Resource" script_class="LetterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/letters/letter_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"lpo_hagedorn"
kind = &"post"
outside = "An Wiebke Hagedorn, Hollerbrück"
text = "Werte Frau Hagedorn. Ob Sie zu Weihnachten wieder die zweite Stimme singen? Ohne Sie fällt der Alt so dünn aus. Der Gesangverein."
sealed = true
sender = "der Gesangverein"
recipient = &"grave"
asks = &""
conditions = PackedStringArray()
choice_actions = Dictionary[StringName, PackedStringArray]({})
choice_texts = Dictionary[StringName, String]({})
reply_text = "Der Gesangverein schreibt: „Wir singen zu Weihnachten ohne die zweite Stimme. Eine Stelle im Alt bleibt leer.“"
story_id = &"d1_hagedorn"
