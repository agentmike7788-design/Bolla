[gd_resource type="Resource" script_class="LetterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/systems/letters/letter_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"lpo_ott"
kind = &"post"
outside = "An Gerhard Ott, Hollerbrück"
text = "Vater. Wir stehen jetzt in Mainz. Es regnet. Schreib mir, ob die Kuh gekalbt hat. Dein Peter."
sealed = true
sender = "sein Sohn beim Militär"
recipient = &"kin_ott"
asks = &""
conditions = PackedStringArray()
choice_actions = Dictionary[StringName, PackedStringArray]({
&"deliver": PackedStringArray("goodwill:kin_ott:4")
})
choice_texts = Dictionary[StringName, String]({})
reply_text = "Ein Brief aus Mainz: „Gesa hat es mir auch geschrieben. Ich komm, wenn sie mich lassen. Danke, Totengräber.“"
story_id = &"d2_ott"
