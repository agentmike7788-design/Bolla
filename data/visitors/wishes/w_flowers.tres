[resource]
script = ExtResource("1")
id = &"w_flowers"
kind = &"flowers"
ask_text = "Ein paar Blumen. Heide, wenn's geht, die hält den Winter. Ich komm in drei Tagen wieder."
done_text = "Heide. Du hast es nicht vergessen. Hier, nimm. Nein, nimm es."
failed_text = "Nichts. Na ja. Du hast viele."
line_text = ""
