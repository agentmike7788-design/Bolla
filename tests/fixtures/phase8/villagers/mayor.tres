remarks = Dictionary[StringName, PackedStringArray]({
&"event_grave_disturbed": PackedStringArray("Ein offenes Grab auf dem Hügel. Das kommt ins Protokoll, Totengräber. Nicht gegen dich."),
&"friend": PackedStringArray("Unter uns: Die Beine sind besser. Amtlich weiß ich davon nichts."),
&"rep_disreputable": PackedStringArray("Totengräber. Es liegen Beschwerden vor. Schriftlich. Guten Tag."),
&"rep_esteemed": PackedStringArray("Ich habe Sie lobend ins Protokoll geschrieben. Zweimal. Das ist ein Rekord."),
&"rep_renowned": PackedStringArray("Mein verehrter Totengräber! Ich arbeite an einer Satzung für Ihre Ehrung."),
&"rep_respected": PackedStringArray("Totengräber! Die Gemeinde ist zufrieden. Das darf ich amtlich sagen."),
&"rep_unremarkable": PackedStringArray("Guten Tag. Die Amtsstube hat bis sechzehn Uhr geöffnet."),
&"specimens": PackedStringArray("Man redet über Gläser vom Hügel. Ich habe es nicht zu Protokoll genommen. Noch nicht.")
})
circle = Array[StringName]([&"house_sieber"])
mood_lines = Dictionary[StringName, PackedStringArray]({
&"cheerful": PackedStringArray("Die Beine tragen heute. Das ist schon was.", "Ein ordentlicher Tag. Alles in den Büchern."),
&"cross": PackedStringArray("Heute nicht, Totengräber. Morgen.", "Das kommt ins Protokoll. Nicht gegen dich. Noch nicht."),
&"low": PackedStringArray("Die Beine. Lassen wir das.", "Heute ist mir das Amtshaus zu groß."),
&"plain": PackedStringArray("Totengräber. Die Gemeinde hört.", "Kurz, bitte. Die Akten warten.")
})
