[resource]
script = ExtResource("1")
intro_day = 4
intro_minute = 360
notice_minute = 1365
shop = Dictionary[StringName, Dictionary]({&"linen": {"price": 2, "per_night": 3}, &"juniper": {"price": 1, "per_night": 4}})
