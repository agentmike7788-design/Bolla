rumor_after_sales = 3
intro_note = "Wer den Toten etwas nimmt, braucht jemanden, der es abnimmt. Ich komme nach elf an die Westmauer. Frag nach Ilse. – I. K."
greetings = Dictionary[StringName, String]({&"devout": "Du kommst mit leeren Händen. Das steht dir.", &"considerate": "Nur zum Reden? Auch gut. Die Nacht ist lang.", &"matter_of_fact": "Guten Abend, Totengräber. Was bringen die Stillen heute?", &"callous": "Du bist schneller geworden. Das geht vielen so.", &"hardhearted": "Du hast gelernt, nicht hinzusehen. Ich hab's dir nicht beigebracht."})
