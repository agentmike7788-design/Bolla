[resource]
script = ExtResource("1")
id = &"c_trader_lorenz"
title = "Ilse über Lorenz"
text = "Lorenz? Er hat mir nie etwas verkauft. Er hat mir Tee gekocht und gefragt, wer im Dorf die Kranken besucht. Dann hat er aufgeschrieben, was ich sagte."
kind = &"talk"
order = 17
