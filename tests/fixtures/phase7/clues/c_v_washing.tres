[resource]
script = ExtResource("1")
id = &"c_v_washing"
title = "Was die Seelfrau sah"
text = "Liesel hat das Zeichen seit dem Winter, als die Fähre kenterte, an den Toten gesehen und es Lorenz gemeldet, jedes Mal. Seit er fort ist, meldet sie es niemandem mehr. Sie schreibt die Namen in ihr Gesangbuch."
kind = &"talk"
order = 32
