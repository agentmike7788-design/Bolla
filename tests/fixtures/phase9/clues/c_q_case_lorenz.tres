[resource]
script = ExtResource("1")
id = &"c_q_case_lorenz"
title = "Der Herr war schon einmal da"
text = "Brenneisen hat Lambert Grell bezahlt – für Nachrichten, sagt er, nicht für Leiber. Vor einem Jahr war er schon bei Lorenz. Lorenz hat ihn mit der Schaufel vom Hügel gejagt."
kind = &"talk"
order = 410
