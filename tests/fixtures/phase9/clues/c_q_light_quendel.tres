[resource]
script = ExtResource("1")
id = &"c_q_light_quendel"
title = "Licht bei der Quendel"
text = "Bei der Quendel brannte Licht, oben, um eins. Osric fährt da nachts vorbei. Er hält nie an. Diesmal hätte er vielleicht sollen, sagt er."
kind = &"talk"
order = 403
