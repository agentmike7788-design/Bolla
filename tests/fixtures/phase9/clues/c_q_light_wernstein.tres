[resource]
script = ExtResource("1")
id = &"c_q_light_wernstein"
title = "Licht bei der Wernstein"
text = "Ida Wernstein hat Rosine erzählt, in ihrer Kammer hätte die ganze Nacht ein Licht gebrannt, und sie hätte keins angezündet. Am nächsten Tag lag ein Brief unter ihrer Tür."
kind = &"talk"
order = 404
