request_text = "Theres Mangold: „Der Weg hinauf ist lang für alte Knie. Mach einen Platz zum Ausruhen frei, stell eine Bank hin und harke das Laub weg. Dann setz ich mich auch.“"
thanks_text = "Theres hat sich gesetzt, sagt Osric. Ziemlich lange. Dann hat sie ihm Samen für dich mitgegeben."
