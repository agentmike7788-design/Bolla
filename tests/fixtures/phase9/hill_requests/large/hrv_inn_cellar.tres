request_text = "Rosine Wackernagel: „Im Keller steht das Wasser, und der Holunder muss rein, bevor er gärt. Bring Beeren und Holz, und pack einmal mit an. Ich zahl in Wein.“"
thanks_text = "„Trocken und voll“, sagt Rosine. „So mag ich meinen Keller. Und dich auch, heute.“"
