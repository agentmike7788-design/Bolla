; Engine configuration file.
; THE LAST GRAVEKEEPER — Godot 4.7

config_version=5

[application]

config/name="The Last Gravekeeper"
config/description="2.5D Fantasy Graveyard Management / Adventure / RPG"
config/version="0.2.0-phase2"
run/main_scene="res://src/boot/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://src/core/event_bus.gd"
GameConfig="*res://src/core/game_config.gd"
Database="*res://src/core/database.gd"
UIState="*res://src/core/ui_state.gd"
TimeManager="*res://src/systems/time/time_manager.gd"
GameState="*res://src/systems/game_state/game_state.gd"
SaveManager="*res://src/systems/save/save_manager.gd"
Debug="*res://src/debug/debug_console.tscn"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

scene={
"import_script/path": "res://src/core/import/asset_post_import.gd"
}

