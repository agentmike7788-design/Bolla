; Engine configuration file.
; THE LAST GRAVEKEEPER — Godot 4.7

config_version=5

[application]

config/name="The Last Gravekeeper"
config/description="2.5D Fantasy Graveyard Management / Adventure / RPG"
config/version="0.0.1-phase0"
run/main_scene="res://src/boot/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://src/core/event_bus.gd"
